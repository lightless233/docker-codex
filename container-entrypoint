#!/usr/bin/env bash
set -euo pipefail

HOST_UID=${HOST_UID:?HOST_UID is required}
HOST_GID=${HOST_GID:?HOST_GID is required}
RUNTIME_HOME=/home/codex

array_contains() {
  local needle=$1 item
  shift
  for item in "$@"; do
    [[ $item == "$needle" ]] && return 0
  done
  return 1
}

normalize_claude_profile_value() {
  local value=$1 first last

  NORMALIZED_CLAUDE_PROFILE_VALUE=$value
  [[ -n $value ]] || return 0
  first=${value:0:1}
  last=${value: -1}
  if [[ $first == \" || $first == \' || $last == \" || $last == \' ]]; then
    ((${#value} >= 2)) &&
      [[ $first == "$last" && ( $first == \" || $first == \' ) ]] ||
      return 1
    value=${value:1}
    NORMALIZED_CLAUDE_PROFILE_VALUE=${value%?}
  fi
}

load_claude_profile() {
  local file=$1 kind=$2
  local line key value assignment
  local seen_keys=() assignments=()
  local has_base=0 has_auth_token=0 has_api_key=0

  [[ -e $file ]] || {
    printf 'docker-agent: Claude profile does not exist: %s\n' "$file" >&2
    return 1
  }
  [[ ! -L $file && -f $file ]] || {
    printf 'docker-agent: Claude profile must be a regular non-symlink file: %s\n' \
      "$file" >&2
    return 1
  }
  [[ $(stat -c %u "$file") == "$HOST_UID" ]] || {
    printf 'docker-agent: Claude profile has unexpected owner: %s\n' "$file" >&2
    return 1
  }
  [[ $(stat -c %a "$file") == 600 ]] || {
    printf 'docker-agent: Claude profile must have mode 600: %s\n' "$file" >&2
    return 1
  }

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line == *=* ]] || {
      printf '%s\n' 'docker-agent: invalid Claude profile assignment' >&2
      return 1
    }
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || {
      printf 'docker-agent: invalid Claude profile key: %s\n' "$key" >&2
      return 1
    }
    if array_contains "$key" "${seen_keys[@]}"; then
      printf 'docker-agent: duplicate Claude profile key: %s\n' "$key" >&2
      return 1
    fi
    seen_keys+=("$key")
    if ! normalize_claude_profile_value "$value"; then
      printf 'docker-agent: unmatched quote in Claude profile value: %s\n' \
        "$key" >&2
      return 1
    fi
    value=$NORMALIZED_CLAUDE_PROFILE_VALUE

    case $key in
      ANTHROPIC_BASE_URL)
        [[ -n $value ]] || {
          printf '%s\n' 'docker-agent: empty ANTHROPIC_BASE_URL' >&2
          return 1
        }
        has_base=1
        ;;
      ANTHROPIC_AUTH_TOKEN)
        [[ -n $value ]] || {
          printf '%s\n' 'docker-agent: empty ANTHROPIC_AUTH_TOKEN' >&2
          return 1
        }
        has_auth_token=1
        ;;
      ANTHROPIC_API_KEY)
        [[ -n $value ]] || {
          printf '%s\n' 'docker-agent: empty ANTHROPIC_API_KEY' >&2
          return 1
        }
        has_api_key=1
        ;;
      ANTHROPIC_MODEL|ANTHROPIC_DEFAULT_OPUS_MODEL|ANTHROPIC_DEFAULT_SONNET_MODEL|ANTHROPIC_DEFAULT_HAIKU_MODEL|CLAUDE_CODE_SUBAGENT_MODEL)
        ;;
      CLAUDE_CODE_EFFORT_LEVEL)
        [[ $value =~ ^(low|medium|high|xhigh|max|auto)$ ]] || {
          printf '%s\n' \
            'docker-agent: invalid CLAUDE_CODE_EFFORT_LEVEL' >&2
          return 1
        }
        ;;
      *)
        printf 'docker-agent: unsupported Claude profile key: %s\n' "$key" >&2
        return 1
        ;;
    esac
    assignments+=("$key=$value")
  done <"$file"

  if [[ $kind == official-api ]]; then
    ((has_api_key == 1 && has_auth_token == 0 && has_base == 0)) || {
      printf '%s\n' \
        'docker-agent: official API profile requires only ANTHROPIC_API_KEY' >&2
      return 1
    }
  else
    ((has_base == 1 && has_auth_token + has_api_key == 1)) || {
      printf '%s\n' \
        'docker-agent: custom profile requires endpoint and exactly one credential' >&2
      return 1
    }
  fi

  for assignment in "${assignments[@]}"; do
    export "${assignment?}"
  done
}

if ! getent group "$HOST_GID" >/dev/null; then
  groupadd --gid "$HOST_GID" docker-codex
fi
if passwd_entry=$(getent passwd "$HOST_UID"); then
  RUNTIME_USER=${passwd_entry%%:*}
  if [[ $HOST_UID != 0 ]]; then
    usermod --home "$RUNTIME_HOME" --append --groups sudo "$RUNTIME_USER"
  fi
else
  useradd --uid "$HOST_UID" --gid "$HOST_GID" --groups sudo \
    --home-dir "$RUNTIME_HOME" --no-create-home --shell /bin/bash docker-codex
  RUNTIME_USER=docker-codex
fi

mkdir -p "$RUNTIME_HOME" /codex-cache
chown "$HOST_UID:$HOST_GID" "$RUNTIME_HOME" /codex-cache

# On WSL the powershell.exe shim writes clipboard images here and prints the
# matching Windows path, which Codex maps back under /mnt/c before reading.
if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
  mkdir -p /mnt/c/codex-clipboard
  chown "$HOST_UID:$HOST_GID" /mnt/c/codex-clipboard
fi

export HOME=$RUNTIME_HOME
export USER=$RUNTIME_USER
export LOGNAME=$RUNTIME_USER
export CODEX_HOME=${CODEX_HOME:-/codex-home}
export CARGO_HOME=/codex-cache/cargo-home
export XDG_CACHE_HOME=/codex-cache/xdg
export XDG_DATA_HOME=/codex-cache/xdg-data
export NPM_CONFIG_CACHE=/codex-cache/npm
export npm_config_store_dir=/codex-cache/pnpm-store
export PNPM_HOME=/codex-cache/pnpm
export PATH="$PNPM_HOME:$PATH"

# The launcher names the cache volume from the Git common directory, so all
# worktrees of one repository share /codex-cache. Build artifacts must
# therefore be scoped per worktree (computed from the worktree root below):
# a single shared CARGO_TARGET_DIR would leak build.rs fingerprints across
# worktrees. CARGO_HOME above stays shared so registry and git downloads
# are reused.
worktree_root=$(
  gosu "$HOST_UID:$HOST_GID" git -C "$PWD" rev-parse --show-toplevel 2>/dev/null ||
    pwd -P
)
worktree_hash=$(printf '%s' "$worktree_root" | sha256sum | cut -c1-16)
CARGO_TARGET_DIR="/codex-cache/cargo-targets/$(basename "$worktree_root")-$worktree_hash"
export CARGO_TARGET_DIR

if [[ ${1:-} == codex ]]; then
  if ! gosu "$HOST_UID:$HOST_GID" codex login status >/dev/null 2>&1; then
    printf '%s\n' \
      'docker-codex: warning: container cannot use the current Codex login; file auth can be shared, host keyrings cannot.' >&2
  fi
  # Give the in-container Codex the environment facts shipped in the image.
  # Any -c overrides from the caller come later and win.
  agent_notes=${DOCKER_AGENT_AGENT_NOTES:-${DOCKER_CODEX_AGENT_NOTES:-/usr/local/share/docker-agent/agent-notes.md}}
  if [[ -r $agent_notes ]]; then
    set -- codex -c "user_instructions=$(cat "$agent_notes")" "${@:2}"
  fi
elif [[ ${1:-} == claude ]]; then
  connection=${DOCKER_AGENT_CLAUDE_CONNECTION:-}
  [[ -n $connection ]] || {
    printf '%s\n' 'docker-agent: Claude connection is required' >&2
    exit 1
  }
  case $connection in
    official-subscription)
      [[ -z ${DOCKER_AGENT_CLAUDE_PROFILE_FILE:-} ]] || {
        printf '%s\n' \
          'docker-agent: official subscription must not use a profile file' >&2
        exit 1
      }
      ;;
    official-api)
      [[ -n ${DOCKER_AGENT_CLAUDE_PROFILE_FILE:-} ]] || {
        printf '%s\n' \
          'docker-agent: official API connection requires a profile file' >&2
        exit 1
      }
      load_claude_profile \
        "$DOCKER_AGENT_CLAUDE_PROFILE_FILE" official-api
      ;;
    profile:*)
      [[ -n ${DOCKER_AGENT_CLAUDE_PROFILE_FILE:-} ]] || {
        printf '%s\n' \
          'docker-agent: custom Claude connection requires a profile file' >&2
        exit 1
      }
      load_claude_profile \
        "$DOCKER_AGENT_CLAUDE_PROFILE_FILE" custom
      ;;
    *)
      printf 'docker-agent: unsupported Claude connection: %s\n' \
        "$connection" >&2
      exit 1
      ;;
  esac

  export TZ=Etc/UTC
  export LANG=en_US.UTF-8
  export LC_ALL=en_US.UTF-8
  export LANGUAGE=en_US:en
  export DISABLE_AUTOUPDATER=1
  export DISABLE_TELEMETRY=1
  export DISABLE_ERROR_REPORTING=1
  export DISABLE_FEEDBACK_COMMAND=1
  export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
  export CLAUDE_CODE_ATTRIBUTION_HEADER=0

  agent_notes=${DOCKER_AGENT_AGENT_NOTES:-/usr/local/share/docker-agent/agent-notes.md}
  if [[ -r $agent_notes ]]; then
    set -- claude --dangerously-skip-permissions \
      --append-system-prompt-file "$agent_notes" "${@:2}"
  else
    set -- claude --dangerously-skip-permissions "${@:2}"
  fi
fi

exec gosu "$HOST_UID:$HOST_GID" "$@"

  --image IMAGE           Image to use (default: docker-agent:local)
  --isolated NAME         In Git, create branch codex/NAME in a retained worktree
  --bind PATH[:ro]        Bind an absolute directory at the same container path
                          (repeatable; append :ro for read-only)

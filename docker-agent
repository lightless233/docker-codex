      1)
        CLAUDE_CONNECTION=official-api
        CLAUDE_PROFILE_NAME=official-api
        ;;
      2)
        choose_custom_profile_menu || exit 130
        ;;
    esac
    if [[ -n $CLAUDE_PROFILE_NAME ]]; then
      validate_claude_profile_name
    fi
  fi
  resolve_claude_connection
  resolve_claude_credential_source
}


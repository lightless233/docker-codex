#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME=$(basename "$0")

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

usage_agent() {
  cat <<'EOF'
Usage: docker-agent {codex|claude} [options] [--] [agent args...]

Run Codex or Claude Code in Docker against the current Git checkout.

Commands:
  docker-agent codex       Run Codex
  docker-agent claude      Run Claude Code

Use "docker-agent AGENT --help" for agent-specific options.
EOF
}

usage_codex() {
  cat <<'EOF'
Usage: docker-codex [options] [--] [codex args...]
       docker-agent codex [options] [--] [codex args...]

Run Codex in Docker against the current Git checkout.

Options:
  --build                 Build the image before launching
  --image IMAGE           Image to use (default: docker-agent:local)
  --isolated NAME         Create branch codex/NAME in a retained worktree
  --bind PATH[:ro]        Bind an absolute directory at the same container path
                          (repeatable; append :ro for read-only)
  --pat TOKEN             Provide a git access token directly; stored under the
                          data home with mode 600 and mounted read-only at
                          /codex-credentials/pat (visible in shell history;
                          prefer --pat-path)
  --pat-path FILE         Mount a token file read-only at
                          /codex-credentials/pat (DOCKER_AGENT_PAT_PATH sets
                          the default; legacy DOCKER_CODEX_PAT_PATH also works)
  --disable-clipboard     Do not forward the host clipboard (display sockets)
                          into the container
  --help, -h              Show this help

Arguments after -- are passed to Codex without reinterpretation.
Isolated worktrees and their branches are retained after the container exits.
EOF
}

usage_claude() {
  cat <<'EOF'
Usage: docker-claude [options] [connection] [--] [claude args...]
       docker-agent claude [options] [connection] [--] [claude args...]

Run Claude Code in Docker against the current Git checkout.

Options:
  --build                   Build the image before launching
  --image IMAGE             Image to use (default: docker-agent:local)
  --isolated NAME           Create branch codex/NAME in a retained worktree
  --bind PATH[:ro]          Bind an absolute directory at the same container path
  --pat TOKEN               Provide a git access token directly
  --pat-path FILE           Mount a git access token file
  --disable-clipboard       Do not forward host display sockets
  --official-subscription   Reuse the supported host Claude OAuth credential
  --official-api            Use the official-api.env API key profile
  --profile NAME            Use a named custom endpoint profile
  --help, -h                Show this help

Without a connection selector, an interactive terminal shows a connection menu.
Non-interactive launches require an explicit connection selector.
Arguments after -- are passed to Claude Code without reinterpretation.
Isolated worktrees and their branches are retained after the container exits.
EOF
}

case $PROGRAM_NAME in
  docker-codex)
    AGENT=codex
    ;;
  docker-claude)
    AGENT=claude
    ;;
  docker-agent)
    case ${1:-} in
      -h|--help)
        usage_agent
        exit 0
        ;;
    esac
    (($# >= 1)) || die "expected agent: codex or claude"
    AGENT=$1
    shift
    [[ $AGENT == codex || $AGENT == claude ]] ||
      die "unsupported agent: $AGENT"
    ;;
  *)
    die "unsupported launcher name: $PROGRAM_NAME"
    ;;
esac

path_is_within() {
  local child=$1 parent=$2
  if [[ $parent == / ]]; then
    return 0
  fi
  [[ $child == "$parent" || $child == "$parent/"* ]]
}

file_uid() {
  if stat -c %u "$1" >/dev/null 2>&1; then
    stat -c %u "$1"
  else
    stat -f %u "$1"
  fi
}

file_mode() {
  if stat -c %a "$1" >/dev/null 2>&1; then
    stat -c %a "$1"
  else
    stat -f %Lp "$1"
  fi
}

array_contains() {
  local needle=$1 item
  shift
  for item in "$@"; do
    [[ $item == "$needle" ]] && return 0
  done
  return 1
}

reject_mount_comma() {
  [[ $1 != *,* ]] ||
    die "Docker --mount paths containing commas are unsupported: $1"
}

append_same_path_mount() {
  local path=$1 mode=${2:-rw}
  [[ -e $path ]] || die "bind source does not exist: $path"
  [[ -d $path ]] || die "bind source must be a directory: $path"
  path=$(cd "$path" && pwd -P)
  reject_mount_comma "$path"
  if [[ $mode == ro ]]; then
    DOCKER_ARGS+=(--mount "type=bind,source=$path,target=$path,readonly")
  else
    DOCKER_ARGS+=(--mount "type=bind,source=$path,target=$path")
  fi
}

append_file_mount() {
  local source=$1 target=$2 mode=${3:-rw}
  reject_mount_comma "$source"
  if [[ $mode == ro ]]; then
    DOCKER_ARGS+=(--mount "type=bind,source=$source,target=$target,readonly")
  else
    DOCKER_ARGS+=(--mount "type=bind,source=$source,target=$target")
  fi
}

repo_id_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

parse_origin_host() {
  local url=$1
  case $url in
    git@*:*)
      url=${url#git@}
      printf '%s\n' "${url%%:*}"
      ;;
    ssh://*)
      url=${url#ssh://}
      url=${url#*@}
      printf '%s\n' "${url%%/*}"
      ;;
    http://*|https://*)
      url=${url#*://}
      printf '%s\n' "${url%%/*}"
      ;;
    *)
      return 1
      ;;
  esac
}

validate_isolated_name() {
  local name=$1
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid isolated worktree name: $name"
  git check-ref-format --branch "codex/$name" >/dev/null 2>&1 ||
    die "invalid isolated worktree name: $name"
}

create_isolated_worktree() {
  local name=$1 current_branch repo_id target branch
  validate_isolated_name "$name"
  current_branch=$(git branch --show-current)
  [[ -n $current_branch ]] ||
    die "--isolated requires the current checkout to be on a branch"

  mkdir -p "$DATA_HOME/worktrees"
  DATA_HOME=$(cd "$DATA_HOME" && pwd -P)
  repo_id=$(repo_id_for "$COMMON_DIR")
  target="$DATA_HOME/worktrees/$repo_id/$name"
  branch="codex/$name"

  [[ ! -e $target ]] ||
    die "isolated worktree path already exists: $target"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    die "isolated worktree branch already exists: $branch"
  fi

  mkdir -p "$(dirname "$target")"
  git worktree add -b "$branch" "$target" HEAD
  CHECKOUT_ROOT=$(cd "$target" && pwd -P)
  START_DIR=$CHECKOUT_ROOT
}

select_claude_connection() {
  local selected=$1
  [[ $AGENT == claude ]] ||
    die "$selected is only valid for Claude"
  [[ -z $CLAUDE_CONNECTION ]] ||
    die "Claude connection selectors are mutually exclusive"
  CLAUDE_CONNECTION=${selected#--}
}

menu_select() {
  local prompt=$1
  shift
  local options=("$@")
  local index=0 key escape_sequence i
  local input_fd=${DOCKER_AGENT_MENU_INPUT_FD:-0}
  local output_fd=${DOCKER_AGENT_MENU_OUTPUT_FD:-1}

  ((${#options[@]} > 0)) || return 1
  while :; do
    printf '\033[2J\033[H%s\n\n' "$prompt" >&"$output_fd"
    for ((i = 0; i < ${#options[@]}; i++)); do
      if ((i == index)); then
        printf '❯ %s\n' "${options[$i]}" >&"$output_fd"
      else
        printf '  %s\n' "${options[$i]}" >&"$output_fd"
      fi
    done
    printf '\n↑/↓ 选择 · Enter 确认 · Esc 取消\n' >&"$output_fd"

    if ! IFS= read -rsn1 key <&"$input_fd"; then
      return 130
    fi
    case $key in
      '')
        MENU_SELECTION=$index
        return 0
        ;;
      j)
        index=$(((index + 1) % ${#options[@]}))
        ;;
      k)
        index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
        ;;
      $'\003')
        return 130
        ;;
      $'\033')
        escape_sequence=
        if ! IFS= read -rsn2 -t 0.1 escape_sequence <&"$input_fd"; then
          return 130
        fi
        case $escape_sequence in
          '[A')
            index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
            ;;
          '[B')
            index=$(((index + 1) % ${#options[@]}))
            ;;
          *)
            return 130
            ;;
        esac
        ;;
    esac
  done
}

choose_custom_profile_menu() {
  local config_root profile_dir file name
  local profile_names=()

  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  profile_dir="$config_root/claude/profiles"
  if [[ -d $profile_dir ]]; then
    while IFS= read -r name; do
      [[ -n $name ]] && profile_names+=("$name")
    done < <(
      shopt -s nullglob
      for file in "$profile_dir"/*.env; do
        name=$(basename "$file" .env)
        [[ $name == official-api ]] && continue
        [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        printf '%s\n' "$name"
      done | LC_ALL=C sort
    )
  fi

  if ((${#profile_names[@]} == 0)); then
    die "no custom Claude profiles found in: $profile_dir
Create one with:
  install -d -m 700 \"$profile_dir\"
  install -m 600 /dev/null \"$profile_dir/NAME.env\""
  fi

  menu_select "请选择自定义 endpoint profile：" "${profile_names[@]}" ||
    return 130
  CLAUDE_PROFILE_NAME=${profile_names[$MENU_SELECTION]}
  CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
}

validate_claude_profile() {
  local file=$1 kind=$2
  local line key value
  local seen_keys=()
  local has_base=0 has_auth_token=0 has_api_key=0

  [[ -e $file ]] || die "Claude profile does not exist: $file"
  [[ ! -L $file ]] || die "Claude profile must not be a symlink: $file"
  [[ -f $file ]] || die "Claude profile must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "Claude profile must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "Claude profile must have mode 600: $file"

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line == *=* ]] || die "invalid Claude profile assignment"
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] ||
      die "invalid Claude profile key: $key"
    array_contains "$key" "${seen_keys[@]}" &&
      die "duplicate Claude profile key: $key"
    seen_keys+=("$key")

    case $key in
      ANTHROPIC_BASE_URL)
        [[ -n $value ]] || die "empty ANTHROPIC_BASE_URL"
        has_base=1
        ;;
      ANTHROPIC_AUTH_TOKEN)
        [[ -n $value ]] || die "empty ANTHROPIC_AUTH_TOKEN"
        has_auth_token=1
        ;;
      ANTHROPIC_API_KEY)
        [[ -n $value ]] || die "empty ANTHROPIC_API_KEY"
        has_api_key=1
        ;;
      ANTHROPIC_MODEL|ANTHROPIC_DEFAULT_OPUS_MODEL|ANTHROPIC_DEFAULT_SONNET_MODEL|ANTHROPIC_DEFAULT_HAIKU_MODEL|CLAUDE_CODE_SUBAGENT_MODEL)
        ;;
      CLAUDE_CODE_EFFORT_LEVEL)
        [[ $value =~ ^(low|medium|high|xhigh|max|auto)$ ]] ||
          die "invalid CLAUDE_CODE_EFFORT_LEVEL"
        ;;
      *)
        die "unsupported Claude profile key: $key"
        ;;
    esac
  done <"$file"

  if [[ $kind == official-api ]]; then
    ((has_api_key == 1 && has_auth_token == 0 && has_base == 0)) ||
      die "official API profile requires only ANTHROPIC_API_KEY"
  else
    ((has_base == 1 && has_auth_token + has_api_key == 1)) ||
      die "custom profile requires endpoint and exactly one credential"
  fi
}

validate_claude_profile_name() {
  [[ $CLAUDE_PROFILE_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid Claude profile name: $CLAUDE_PROFILE_NAME"
  [[ $CLAUDE_PROFILE_NAME != official-api ||
      $CLAUDE_CONNECTION == official-api ]] ||
    die "reserved Claude profile name: official-api"
}

resolve_claude_connection() {
  local expected_profile profile_dir

  [[ $CLAUDE_CONNECTION == official-subscription ]] && return 0

  CONFIG_ROOT=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$CONFIG_ROOT/claude/profiles"
  CONFIG_ROOT=$(cd "$CONFIG_ROOT" && pwd -P)
  path_is_within "$CONFIG_ROOT" "$CHECKOUT_ROOT" &&
    die "docker-agent config home must not be inside the checkout"

  case $CLAUDE_CONNECTION in
    official-api)
      expected_profile="$CONFIG_ROOT/claude/profiles/official-api.env"
      ;;
    profile:*)
      expected_profile="$CONFIG_ROOT/claude/profiles/$CLAUDE_PROFILE_NAME.env"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  profile_dir=$(cd "$(dirname "$expected_profile")" && pwd -P)
  CLAUDE_PROFILE_PATH="$profile_dir/$(basename "$expected_profile")"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CONFIG_ROOT" ||
    die "Claude profile resolves outside docker-agent config home"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CHECKOUT_ROOT" &&
    die "Claude profile must not be inside the checkout"

  if [[ $CLAUDE_CONNECTION == official-api ]]; then
    validate_claude_profile "$CLAUDE_PROFILE_PATH" official-api
  else
    validate_claude_profile "$CLAUDE_PROFILE_PATH" custom
  fi
}

validate_owned_mode_600_file() {
  local file=$1 label=$2
  [[ -e $file ]] || die "$label does not exist: $file"
  [[ ! -L $file ]] || die "$label must not be a symlink: $file"
  [[ -f $file ]] || die "$label must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "$label must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "$label must have mode 600: $file"
}

resolve_claude_credential_source() {
  local host_claude_home

  [[ $CLAUDE_CONNECTION == official-subscription ]] || return 0
  if [[ $HOST_OS == Darwin ]]; then
    die "host Claude subscription credentials are stored in macOS Keychain; use --official-api or --profile"
  fi

  host_claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  CLAUDE_CREDENTIAL_PATH="$host_claude_home/.credentials.json"
  validate_owned_mode_600_file \
    "$CLAUDE_CREDENTIAL_PATH" "Claude OAuth credential"
  CLAUDE_CREDENTIAL_PATH=$(
    cd "$(dirname "$CLAUDE_CREDENTIAL_PATH")" &&
      printf '%s/%s\n' "$(pwd -P)" "$(basename "$CLAUDE_CREDENTIAL_PATH")"
  )
}

slug_for() {
  local raw=$1 fallback=$2 slug
  slug=$(LC_ALL=C printf '%s' "$raw" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-48)
  [[ -n $slug ]] || slug=$fallback
  printf '%s\n' "$slug"
}

path_hash_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

ensure_state_identity() {
  local state_dir=$1 connection_id=$2
  local identity="$state_dir/.docker-agent-identity"
  local expected
  expected=$(mktemp)
  printf '%s\0' \
    "$COMMON_DIR" "$CHECKOUT_ROOT" claude "$connection_id" >"$expected"

  if [[ -L $identity || (-e $identity && ! -f $identity) ]]; then
    rm -f "$expected"
    die "Claude state identity must be a regular non-symlink file: $identity"
  fi
  if [[ -e $identity ]]; then
    if [[ $(file_uid "$identity") != "$(id -u)" ||
          $(file_mode "$identity") != 600 ]]; then
      rm -f "$expected"
      die "Claude state identity has unsafe metadata: $identity"
    fi
    cmp -s "$expected" "$identity" || {
      rm -f "$expected"
      die "Claude state identity does not match: $state_dir"
    }
  else
    install -m 600 "$expected" "$identity"
  fi
  rm -f "$expected"
}

prepare_claude_state() {
  local repo_name repo_id worktree_id state_base

  if [[ $(basename "$COMMON_DIR") == .git ]]; then
    repo_name=$(basename "$(dirname "$COMMON_DIR")")
  else
    repo_name=$(basename "$COMMON_DIR")
  fi
  repo_id="$(slug_for "$repo_name" repo)-$(path_hash_for "$COMMON_DIR")"
  worktree_id="$(slug_for "$(basename "$CHECKOUT_ROOT")" worktree)-$(path_hash_for "$CHECKOUT_ROOT")"
  state_base="$DATA_HOME/claude/repos/$repo_id/worktrees/$worktree_id"

  case $CLAUDE_CONNECTION in
    official-subscription|official-api)
      CLAUDE_STATE_DIR="$state_base/$CLAUDE_CONNECTION"
      ;;
    profile:*)
      CLAUDE_STATE_DIR="$state_base/profiles/${CLAUDE_CONNECTION#profile:}"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  install -d -m 700 "$CLAUDE_STATE_DIR"
  CLAUDE_STATE_DIR=$(cd "$CLAUDE_STATE_DIR" && pwd -P)
  ensure_state_identity "$CLAUDE_STATE_DIR" "$CLAUDE_CONNECTION"
}

DOCKER_BIN=${DOCKER_AGENT_DOCKER_BIN:-${DOCKER_CODEX_DOCKER_BIN:-docker}}
IMAGE=${DOCKER_AGENT_IMAGE:-${DOCKER_CODEX_IMAGE:-docker-agent:local}}
HOST_OS=${DOCKER_AGENT_HOST_OS:-${DOCKER_CODEX_HOST_OS:-$(uname -s)}}
DATA_HOME=${DOCKER_AGENT_DATA_HOME:-${DOCKER_CODEX_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/docker-agent}}
WAYLAND_DIR_OVERRIDE=${DOCKER_AGENT_WAYLAND_DIR:-${DOCKER_CODEX_WAYLAND_DIR:-}}
X11_DIR_OVERRIDE=${DOCKER_AGENT_X11_DIR:-${DOCKER_CODEX_X11_DIR:-}}
BUILD=0
ISOLATED=
CLIPBOARD=1
BIND_SPECS=()
PAT_VALUE=
PAT_PATH=${DOCKER_AGENT_PAT_PATH:-${DOCKER_CODEX_PAT_PATH:-}}
CLAUDE_CONNECTION=
CLAUDE_PROFILE_NAME=
CLAUDE_PROFILE_PATH=
CLAUDE_CREDENTIAL_PATH=
CLAUDE_STATE_DIR=
MENU_SELECTION=0
AGENT_ARGS=()

while (($#)); do
  case $1 in
    --build)
      BUILD=1
      shift
      ;;
    --image)
      (($# >= 2)) || die "--image requires a value"
      IMAGE=$2
      shift 2
      ;;
    --isolated)
      (($# >= 2)) || die "--isolated requires a name"
      ISOLATED=$2
      shift 2
      ;;
    --bind)
      (($# >= 2)) || die "--bind requires a path"
      BIND_SPECS+=("$2")
      shift 2
      ;;
    --pat)
      (($# >= 2)) || die "--pat requires a value"
      PAT_VALUE=$2
      shift 2
      ;;
    --pat-path)
      (($# >= 2)) || die "--pat-path requires a file"
      PAT_PATH=$2
      shift 2
      ;;
    --disable-clipboard)
      CLIPBOARD=0
      shift
      ;;
    --official-subscription)
      select_claude_connection "$1"
      shift
      ;;
    --official-api)
      select_claude_connection "$1"
      CLAUDE_PROFILE_NAME=official-api
      shift
      ;;
    --profile)
      (($# >= 2)) || die "--profile requires a name"
      select_claude_connection "$1"
      CLAUDE_PROFILE_NAME=$2
      CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
      shift 2
      ;;
    --)
      shift
      AGENT_ARGS=("$@")
      break
      ;;
    --help|-h)
      if [[ $AGENT == codex ]]; then
        usage_codex
      else
        usage_claude
      fi
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

if [[ $AGENT == claude ]]; then
  if [[ -n $CLAUDE_PROFILE_NAME ]]; then
    validate_claude_profile_name
  fi
fi

command -v git >/dev/null 2>&1 || die "git is required"
command -v "$DOCKER_BIN" >/dev/null 2>&1 || die "docker is required"

if [[ -n $PAT_VALUE && -n $PAT_PATH ]]; then
  die "--pat and --pat-path are mutually exclusive"
fi

START_DIR=$(pwd -P)
CHECKOUT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) ||
  die "current directory is not inside a Git checkout"
CHECKOUT_ROOT=$(cd "$CHECKOUT_ROOT" && pwd -P)

if [[ $AGENT == claude ]]; then
  if [[ -z $CLAUDE_CONNECTION ]]; then
    if [[ ${DOCKER_AGENT_TEST_FORCE_TTY:-} != 1 ]] &&
      { [[ ! -t 0 ]] || [[ ! -t 1 ]]; }; then
      die "non-interactive Claude launch requires --official-subscription, --official-api, or --profile NAME"
    fi
    if ! menu_select "请选择 Claude Code 的连接方式：" \
      "Anthropic 官方订阅 / OAuth" \
      "Anthropic 官方 API key" \
      "自定义 endpoint"; then
      exit 130
    fi
    case $MENU_SELECTION in
      0)
        CLAUDE_CONNECTION=official-subscription
        ;;
      1)
        CLAUDE_CONNECTION=official-api
        CLAUDE_PROFILE_NAME=official-api
        ;;
      2)
        choose_custom_profile_menu || exit 130
        ;;
    esac
    if [[ -n $CLAUDE_PROFILE_NAME ]]; then
      validate_claude_profile_name
    fi
  fi
  resolve_claude_connection
  resolve_claude_credential_source
fi

COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
COMMON_DIR=$(cd "$COMMON_DIR" && pwd -P)
GIT_DIR=$(git rev-parse --path-format=absolute --git-dir)
GIT_DIR=$(cd "$GIT_DIR" && pwd -P)

if [[ -n $ISOLATED ]]; then
  create_isolated_worktree "$ISOLATED"
  COMMON_DIR=$(git -C "$CHECKOUT_ROOT" rev-parse --path-format=absolute --git-common-dir)
  COMMON_DIR=$(cd "$COMMON_DIR" && pwd -P)
  GIT_DIR=$(git -C "$CHECKOUT_ROOT" rev-parse --path-format=absolute --git-dir)
  GIT_DIR=$(cd "$GIT_DIR" && pwd -P)
fi
if [[ $AGENT == claude ]]; then
  prepare_claude_state
fi
REPO_ID=$(repo_id_for "$COMMON_DIR")

DOCKER_ARGS=(run --rm)
if [[ -t 0 && -t 1 ]]; then
  DOCKER_ARGS+=(-it)
fi
DOCKER_ARGS+=(--env "HOST_UID=$(id -u)" --env "HOST_GID=$(id -g)")
append_same_path_mount "$CHECKOUT_ROOT"
if [[ $AGENT == codex ]]; then
  CODEX_HOME_SOURCE=${CODEX_HOME:-$HOME/.codex}
  [[ -d $CODEX_HOME_SOURCE ]] ||
    die "Codex home does not exist: $CODEX_HOME_SOURCE"
  CODEX_HOME_SOURCE=$(cd "$CODEX_HOME_SOURCE" && pwd -P)
  reject_mount_comma "$CODEX_HOME_SOURCE"
  DOCKER_ARGS+=(--env "CODEX_HOME=/codex-home")
  DOCKER_ARGS+=(--mount "type=bind,source=$CODEX_HOME_SOURCE,target=/codex-home")
else
  reject_mount_comma "$CLAUDE_STATE_DIR"
  DOCKER_ARGS+=(--mount "type=bind,source=$CLAUDE_STATE_DIR,target=/claude-state")
  DOCKER_ARGS+=(--env "CLAUDE_CONFIG_DIR=/claude-state")
  if [[ -n $CLAUDE_CREDENTIAL_PATH ]]; then
    append_file_mount \
      "$CLAUDE_CREDENTIAL_PATH" /claude-state/.credentials.json
  fi
  if [[ -n $CLAUDE_PROFILE_PATH ]]; then
    reject_mount_comma "$CLAUDE_PROFILE_PATH"
    DOCKER_ARGS+=(--mount "type=bind,source=$CLAUDE_PROFILE_PATH,target=/run/docker-agent/claude-profile.env,readonly")
    DOCKER_ARGS+=(--env "DOCKER_AGENT_CLAUDE_PROFILE_FILE=/run/docker-agent/claude-profile.env")
  fi
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CLAUDE_CONNECTION=$CLAUDE_CONNECTION")
fi
DOCKER_ARGS+=(--mount "type=volume,source=docker-codex-cache-$REPO_ID,target=/codex-cache")

if [[ -n $PAT_VALUE ]]; then
  install -d -m 700 "$DATA_HOME/pat"
  PAT_PATH=$DATA_HOME/pat/$REPO_ID
  (umask 077; printf '%s\n' "$PAT_VALUE" >"$PAT_PATH")
  chmod 600 "$PAT_PATH"
fi
if [[ -n $PAT_PATH ]]; then
  [[ -e $PAT_PATH ]] || die "PAT file does not exist: $PAT_PATH"
  [[ -f $PAT_PATH ]] || die "PAT path must be a regular file: $PAT_PATH"
  PAT_PATH=$(cd "$(dirname "$PAT_PATH")" && pwd -P)/$(basename "$PAT_PATH")
  reject_mount_comma "$PAT_PATH"
  DOCKER_ARGS+=(--mount "type=bind,source=$PAT_PATH,target=/codex-credentials/pat,readonly")
  # Git reads GIT_CONFIG_KEY_n/VALUE_n as extra config entries, so the
  # container gets a credential helper and an SSH-to-HTTPS rewrite for the
  # origin host without touching any config file shared with the host.
  # shellcheck disable=SC2016 # $(cat ...) must stay literal; git runs the helper.
  pat_helper='!f() { echo username=x-access-token; echo "password=$(cat /codex-credentials/pat)"; }; f'
  origin_url=$(git remote get-url origin 2>/dev/null || true)
  origin_host=$(parse_origin_host "$origin_url" 2>/dev/null || true)
  if [[ -n $origin_host ]]; then
    DOCKER_ARGS+=(--env "GIT_CONFIG_COUNT=3")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_0=credential.https://$origin_host.helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_0=$pat_helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_1=url.https://$origin_host/.insteadOf")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_1=git@$origin_host:")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_2=url.https://$origin_host/.insteadOf")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_2=ssh://git@$origin_host/")
  else
    DOCKER_ARGS+=(--env "GIT_CONFIG_COUNT=1")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_0=credential.helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_0=$pat_helper")
  fi
fi

if ! path_is_within "$COMMON_DIR" "$CHECKOUT_ROOT"; then
  append_same_path_mount "$COMMON_DIR"
fi
if ! path_is_within "$GIT_DIR" "$CHECKOUT_ROOT" &&
  ! path_is_within "$GIT_DIR" "$COMMON_DIR"; then
  append_same_path_mount "$GIT_DIR"
fi
for bind_spec in "${BIND_SPECS[@]}"; do
  bind_mode=rw
  bind_path=$bind_spec
  if [[ $bind_spec == *:ro ]]; then
    bind_mode=ro
    bind_path=${bind_spec%:ro}
  fi
  [[ $bind_path == /* ]] ||
    die "--bind requires an absolute path: $bind_path"
  append_same_path_mount "$bind_path" "$bind_mode"
done

DOCKER_ARGS+=(--workdir "$START_DIR")
if [[ $HOST_OS == Linux ]]; then
  DOCKER_ARGS+=(--add-host "host.docker.internal:host-gateway")
elif [[ $HOST_OS != Darwin ]]; then
  die "unsupported host OS: $HOST_OS"
fi

# Clipboard image paste is forwarded by default; --disable-clipboard opts
# out. On WSLg only the Wayland socket is needed: the powershell.exe shim
# reads images through wl-paste, and Codex's first X11 attempt fails fast
# into that fallback. Native Linux reads the clipboard through the X11
# socket directly. Sockets are mounted as single read-only file binds.
if ((CLIPBOARD)); then
  if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
    DOCKER_ARGS+=(--env "WSL_DISTRO_NAME=$WSL_DISTRO_NAME")
    wayland_dir=${WAYLAND_DIR_OVERRIDE:-/mnt/wslg/runtime-dir}
  else
    wayland_dir=${WAYLAND_DIR_OVERRIDE:-${XDG_RUNTIME_DIR:-}}
  fi
  if [[ -n ${WAYLAND_DISPLAY:-} && -n $wayland_dir &&
        -e $wayland_dir/$WAYLAND_DISPLAY ]]; then
    reject_mount_comma "$wayland_dir"
    DOCKER_ARGS+=(--mount "type=bind,source=$wayland_dir/$WAYLAND_DISPLAY,target=/run/docker-codex/$WAYLAND_DISPLAY,readonly")
    DOCKER_ARGS+=(--env "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
    DOCKER_ARGS+=(--env "XDG_RUNTIME_DIR=/run/docker-codex")
  fi
  if [[ -z ${WSL_DISTRO_NAME:-} && -n ${DISPLAY:-} ]]; then
    x11_dir=${X11_DIR_OVERRIDE:-/tmp/.X11-unix}
    x11_num=${DISPLAY%%.*}
    x11_num=${x11_num#*:}
    x11_socket=$x11_dir/X$x11_num
    if [[ -e $x11_socket ]]; then
      reject_mount_comma "$x11_socket"
      DOCKER_ARGS+=(--mount "type=bind,source=$x11_socket,target=$x11_socket,readonly")
      DOCKER_ARGS+=(--env "DISPLAY=$DISPLAY")
      if [[ -n ${XAUTHORITY:-} && -f $XAUTHORITY ]]; then
        reject_mount_comma "$XAUTHORITY"
        DOCKER_ARGS+=(--mount "type=bind,source=$XAUTHORITY,target=$XAUTHORITY,readonly")
        DOCKER_ARGS+=(--env "XAUTHORITY=$XAUTHORITY")
      fi
    fi
  fi
fi

"$DOCKER_BIN" info >/dev/null 2>&1 ||
  die "Docker daemon is unavailable"

if ((BUILD)); then
  SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
  [[ -f $SCRIPT_DIR/Dockerfile && -f $SCRIPT_DIR/container-entrypoint ]] ||
    die "--build requires the docker-agent source checkout; run the repository copy"
  "$DOCKER_BIN" build --tag "$IMAGE" "$SCRIPT_DIR"
else
  "$DOCKER_BIN" image inspect "$IMAGE" >/dev/null 2>&1 ||
    die "image not found: $IMAGE (run with --build)"
fi

case $AGENT in
  codex)
    FINAL_ARGS=(codex --yolo --disable apps "${AGENT_ARGS[@]}")
    ;;
  claude)
    FINAL_ARGS=(claude "${AGENT_ARGS[@]}")
    ;;
esac

exec "$DOCKER_BIN" "${DOCKER_ARGS[@]}" "$IMAGE" "${FINAL_ARGS[@]}"

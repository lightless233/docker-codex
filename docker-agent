# Cursor Agent keeps per-project state, including the workspace-trust marker and
# session history, under $HOME/.cursor/projects. CURSOR_CONFIG_DIR relocates
# only cli-config.json, so the whole directory has to be shared or every launch
# looks like a brand new machine. It is mounted at a neutral path and linked
# into place by the entrypoint, which owns the container home layout.
configure_cursor_agent_runtime() {
  local cursor_home_source
  cursor_home_source=${DOCKER_AGENT_CURSOR_HOME:-$HOME/.cursor}
  [[ $cursor_home_source == /* ]] ||
    die "Cursor data directory must be an absolute path: $cursor_home_source"
  if [[ -e $cursor_home_source && ! -d $cursor_home_source ]]; then
    die "Cursor data directory is not a directory: $cursor_home_source"
  fi
  install -d -m 700 "$cursor_home_source"
  cursor_home_source=$(cd "$cursor_home_source" && pwd -P)
  reject_mount_comma "$cursor_home_source"
  DOCKER_ARGS+=(--mount "type=bind,source=$cursor_home_source,target=/cursor-home")
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CURSOR_HOME_MOUNT=/cursor-home")

  reject_mount_comma "$CURSOR_API_KEY_PATH"
  DOCKER_ARGS+=(--mount "type=bind,source=$CURSOR_API_KEY_PATH,target=/run/docker-agent/cursor-api-key,readonly")
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CURSOR_API_KEY_FILE=/run/docker-agent/cursor-api-key")
}

cursor_agent_selects_own_mode() {
  local arg
  for arg in ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}; do
    case $arg in
      -f|--force|--yolo|--auto-review)
        return 0
        ;;
    esac
  done
  return 1
}

# The CLI's own -w/--worktree creates the worktree under the container-private
# HOME, so its edits vanish with the container while the host repository keeps a
# prunable worktree registration and the new branch. The launcher still passes
# the flag through, but says so first.
warn_cursor_agent_worktree() {
  local arg
  for arg in ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}; do
    case $arg in
      -w|--worktree|--worktree=*)
        cat >&2 <<'EOF'
================================================================================
WARNING: CURSOR AGENT WORKTREE / Cursor Agent 自带 worktree

-w/--worktree creates the worktree inside the container, so every edit made
there is lost when the container exits, and the host repository is left with a
prunable worktree entry plus the new branch.
该选项在容器内创建 worktree：容器退出后其中的修改全部丢失，宿主仓库则会
残留一条失效的 worktree 记录和新分支。

Use --isolated NAME instead to get a worktree that lives on the host.
请改用 --isolated NAME，它在宿主上创建可保留的 worktree。
================================================================================
EOF
        return 0
        ;;
    esac
  done
}

cursor_agent_final_args() {
  warn_cursor_agent_worktree
  # --disable-auto-update is a hidden flag; without it the pinned version in the
  # image can replace itself at runtime.
  if cursor_agent_selects_own_mode; then
    FINAL_ARGS=(cursor-agent --disable-auto-update \
      ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"})
  else
    FINAL_ARGS=(cursor-agent --disable-auto-update --force \
      ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"})
  fi
}

run_macos_clipboard_monitor() {
  local output_dir=$1
  "$OSASCRIPT_BIN" -l JavaScript - "$output_dir" <<'JXA'
ObjC.import("AppKit");
ObjC.import("Foundation");

function removeFileIfPresent(fileManager, path) {
    if (fileManager.fileExistsAtPath($(path))) {
        fileManager.removeItemAtPathError($(path), null);
    }
}

function clipboardImage(pasteboard) {
    return $.NSImage.alloc.initWithPasteboard(pasteboard);
}

function writeCurrentImage(pasteboard, fileManager, outputPath) {
    var image = clipboardImage(pasteboard);
    if (!image) {
        removeFileIfPresent(fileManager, outputPath);
        return;
    }

    var tiff = image.TIFFRepresentation;
    if (!tiff) {
        removeFileIfPresent(fileManager, outputPath);
        return;
    }
    var bitmap = $.NSBitmapImageRep.imageRepWithData(tiff);
    if (!bitmap) {
        removeFileIfPresent(fileManager, outputPath);
        return;
    }
    var png = bitmap.representationUsingTypeProperties(
        $.NSBitmapImageFileTypePNG,
        $({})
    );
    if (!png || !png.writeToFileAtomically($(outputPath), true)) {
        removeFileIfPresent(fileManager, outputPath);
    }
}

function run(argv) {
    var outputDir = argv[0];
    var outputPath = outputDir + "/latest.png";
    var readyPath = outputDir + "/.ready";
    var pasteboard = $.NSPasteboard.generalPasteboard;
    var fileManager = $.NSFileManager.defaultManager;
    var lastChange = Number(pasteboard.changeCount);

    writeCurrentImage(pasteboard, fileManager, outputPath);
    $.NSData.data.writeToFileAtomically($(readyPath), true);

    while (true) {
        $.NSThread.sleepForTimeInterval(0.1);
        var currentChange = Number(pasteboard.changeCount);
        if (currentChange !== lastChange) {
            lastChange = currentChange;
            writeCurrentImage(pasteboard, fileManager, outputPath);
        }
    }
}
JXA
}

cleanup_macos_clipboard() {
  local exit_status=$?
  trap - EXIT
  if [[ -n ${MACOS_CLIPBOARD_PID:-} ]]; then
    kill "$MACOS_CLIPBOARD_PID" >/dev/null 2>&1 || true
    wait "$MACOS_CLIPBOARD_PID" 2>/dev/null || true
    MACOS_CLIPBOARD_PID=
  fi
  if [[ -n ${MACOS_CLIPBOARD_DIR:-} &&
        -n ${MACOS_CLIPBOARD_ROOT:-} &&
        $MACOS_CLIPBOARD_DIR == "$MACOS_CLIPBOARD_ROOT"/session.* ]]; then
    rm -rf -- "$MACOS_CLIPBOARD_DIR"
  fi
  MACOS_CLIPBOARD_DIR=
  return "$exit_status"
}

warn_macos_clipboard_unavailable() {
  printf '%s\n' \
    "$PROGRAM_NAME: warning: macOS clipboard image forwarding is unavailable; continuing without it${1:+: $1}" >&2
}

start_macos_clipboard_bridge() {
  local attempt clipboard_log
  [[ $HOST_OS == Darwin && $CLIPBOARD == 1 ]] || return 0
  case $AGENT in
    codex|claude) ;;
    *) return 0 ;;
  esac

  if ! command -v "$OSASCRIPT_BIN" >/dev/null 2>&1; then
    warn_macos_clipboard_unavailable "osascript not found: $OSASCRIPT_BIN"
    return 0
  fi
  if ! install -d -m 700 "$DATA_HOME/clipboard"; then
    warn_macos_clipboard_unavailable "cannot create $DATA_HOME/clipboard"
    return 0
  fi
  MACOS_CLIPBOARD_ROOT=$(cd "$DATA_HOME/clipboard" && pwd -P)
  if ! MACOS_CLIPBOARD_DIR=$(mktemp -d "$MACOS_CLIPBOARD_ROOT/session.XXXXXX"); then
    warn_macos_clipboard_unavailable "cannot create a private clipboard session directory"
    MACOS_CLIPBOARD_ROOT=
    return 0
  fi
  # Docker Desktop commonly exposes bind mounts as root-owned inside its Linux
  # VM. The parent remains host-private (0700); make only this random session
  # directory traversable so the mapped runtime UID can read the snapshot.
  chmod 755 "$MACOS_CLIPBOARD_DIR"
  trap cleanup_macos_clipboard EXIT
  clipboard_log=$MACOS_CLIPBOARD_DIR/monitor.log
  run_macos_clipboard_monitor "$MACOS_CLIPBOARD_DIR" \
    >"$MACOS_CLIPBOARD_DIR/monitor.out" 2>"$clipboard_log" &
  MACOS_CLIPBOARD_PID=$!

  attempt=0
  while ((attempt < 40)) && [[ ! -e $MACOS_CLIPBOARD_DIR/.ready ]]; do
    if ! kill -0 "$MACOS_CLIPBOARD_PID" 2>/dev/null; then
      break
    fi
    sleep 0.05
    attempt=$((attempt + 1))
  done
  if [[ ! -e $MACOS_CLIPBOARD_DIR/.ready ]]; then
    if [[ -s $clipboard_log ]]; then
      warn_macos_clipboard_unavailable "$(head -1 "$clipboard_log")"
    else
      warn_macos_clipboard_unavailable "the NSPasteboard monitor did not start"
    fi
    cleanup_macos_clipboard
    MACOS_CLIPBOARD_ROOT=
    return 0
  fi

  reject_mount_comma "$MACOS_CLIPBOARD_DIR"
  DOCKER_ARGS+=(--mount "type=bind,source=$MACOS_CLIPBOARD_DIR,target=/run/docker-agent/macos-clipboard,readonly")
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CLIPBOARD_BACKEND=macos")
  if [[ $AGENT == codex ]]; then
    # Codex 0.149.0 only enters its PowerShell clipboard fallback after a WSL
    # check. WSL_INTEROP is the narrowest marker that reaches that check; the
    # shim above handles the call without exposing a Windows interop socket.
    DOCKER_ARGS+=(--env "WSL_INTEROP=/run/docker-agent/macos-clipboard")
  fi
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}


repo_id_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

parse_origin_host() {
  local url=$1
  case $url in
    git@*:*)
      url=${url#git@}
      printf '%s\n' "${url%%:*}"
      ;;
    ssh://*)
      url=${url#ssh://}
      url=${url#*@}
      printf '%s\n' "${url%%/*}"
      ;;
    http://*|https://*)
      url=${url#*://}
      printf '%s\n' "${url%%/*}"
      ;;
    *)
      return 1
      ;;
  esac
}

validate_isolated_name() {
  local name=$1
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid isolated worktree name: $name"
  git check-ref-format --branch "codex/$name" >/dev/null 2>&1 ||
    die "invalid isolated worktree name: $name"
}

create_isolated_worktree() {
  local name=$1 current_branch repo_id target branch
  validate_isolated_name "$name"
  current_branch=$(git branch --show-current)
  [[ -n $current_branch ]] ||
    die "--isolated requires the current checkout to be on a branch"

  mkdir -p "$DATA_HOME/worktrees"
  DATA_HOME=$(cd "$DATA_HOME" && pwd -P)
  repo_id=$(repo_id_for "$COMMON_DIR")
  target="$DATA_HOME/worktrees/$repo_id/$name"
  branch="codex/$name"

  [[ ! -e $target ]] ||
    die "isolated worktree path already exists: $target"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    die "isolated worktree branch already exists: $branch"
  fi

  mkdir -p "$(dirname "$target")"
  git worktree add -b "$branch" "$target" HEAD
  CHECKOUT_ROOT=$(cd "$target" && pwd -P)
  START_DIR=$CHECKOUT_ROOT
}

select_claude_connection() {
  local selected=$1
  [[ $AGENT == claude ]] ||
    die "$selected is only valid for Claude"
  [[ -z $CLAUDE_CONNECTION ]] ||
    die "Claude connection selectors are mutually exclusive"
  CLAUDE_CONNECTION=${selected#--}
}

menu_select() {
  local prompt=$1
  shift
  local options=("$@")
  local index=0 key escape_sequence i
  local input_fd=${DOCKER_AGENT_MENU_INPUT_FD:-0}
  local output_fd=${DOCKER_AGENT_MENU_OUTPUT_FD:-1}

  ((${#options[@]} > 0)) || return 1
  while :; do
    printf '\033[2J\033[H%s\n\n' "$prompt" >&"$output_fd"
    for ((i = 0; i < ${#options[@]}; i++)); do
      if ((i == index)); then
        printf '❯ %s\n' "${options[$i]}" >&"$output_fd"
      else
        printf '  %s\n' "${options[$i]}" >&"$output_fd"
      fi
    done
    printf '\n↑/↓ 选择 · Enter 确认 · Esc 取消\n' >&"$output_fd"

    if ! IFS= read -rsn1 key <&"$input_fd"; then
      return 130
    fi
    case $key in
      '')
        MENU_SELECTION=$index
        return 0
        ;;
      j)
        index=$(((index + 1) % ${#options[@]}))
        ;;
      k)
        index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
        ;;
      $'\003')
        return 130
        ;;
      $'\033')
        escape_sequence=
        if ! IFS= read -rsn2 -t 0.1 escape_sequence <&"$input_fd"; then
          return 130
        fi
        case $escape_sequence in
          '[A')
            index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
            ;;
          '[B')
            index=$(((index + 1) % ${#options[@]}))
            ;;
          *)
            return 130
            ;;
        esac
        ;;
    esac
  done
}

normalize_claude_profile_value() {
  local value=$1 first last

  NORMALIZED_CLAUDE_PROFILE_VALUE=$value
  [[ -n $value ]] || return 0
  first=${value:0:1}
  last=${value: -1}
  if [[ $first == \" || $first == \' || $last == \" || $last == \' ]]; then
    ((${#value} >= 2)) &&
      [[ $first == "$last" && ( $first == \" || $first == \' ) ]] ||
      return 1
    value=${value:1}
    NORMALIZED_CLAUDE_PROFILE_VALUE=${value%?}
  fi
}

claude_profile_model_summary() {
  local file=$1 line model sanitized

  if [[ -f $file && ! -L $file && -r $file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == ANTHROPIC_MODEL=* ]] || continue
      model=${line#*=}
      if ! normalize_claude_profile_value "$model"; then
        break
      fi
      model=$NORMALIZED_CLAUDE_PROFILE_VALUE
      if [[ -n $model ]]; then
        sanitized=$(printf '%s' "$model" | LC_ALL=C tr -d '[:cntrl:]')
        if [[ -n $sanitized ]]; then
          if ((${#sanitized} > 64)); then
            sanitized="${sanitized:0:61}..."
          fi
          printf '主模型: %s\n' "$sanitized"
          return
        fi
      fi
      break
    done <"$file"
  fi

  printf '⚠ 主模型未配置：将使用 Claude 默认模型名\n'
}

choose_custom_profile_menu() {
  local config_root profile_dir file name summary
  local profile_names=()
  local profile_labels=()

  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  profile_dir="$config_root/claude/profiles"
  if [[ -d $profile_dir ]]; then
    while IFS= read -r name; do
      if [[ -n $name ]]; then
        profile_names+=("$name")
        summary=$(claude_profile_model_summary "$profile_dir/$name.env")
        profile_labels+=("$name  [$summary]")
      fi
    done < <(
      shopt -s nullglob
      for file in "$profile_dir"/*.env; do
        name=$(basename "$file" .env)
        [[ $name == official-api ]] && continue
        [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        printf '%s\n' "$name"
      done | LC_ALL=C sort
    )
  fi

  if ((${#profile_names[@]} == 0)); then
    die "no custom Claude profiles found in: $profile_dir
Create one with:
  install -d -m 700 \"$profile_dir\"
  install -m 600 /dev/null \"$profile_dir/NAME.env\""
  fi

  menu_select "请选择自定义 endpoint profile：" "${profile_labels[@]}" ||
    return 130
  CLAUDE_PROFILE_NAME=${profile_names[$MENU_SELECTION]}
  CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
}

validate_claude_profile() {
  local file=$1 kind=$2
  local line key value
  local seen_keys=()
  local has_base=0 has_auth_token=0 has_api_key=0

  [[ -e $file ]] || die "Claude profile does not exist: $file"
  [[ ! -L $file ]] || die "Claude profile must not be a symlink: $file"
  [[ -f $file ]] || die "Claude profile must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "Claude profile must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "Claude profile must have mode 600: $file"

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line == *=* ]] || die "invalid Claude profile assignment"
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
      die "invalid Claude profile key: $key"
    array_contains "$key" "${seen_keys[@]}" &&
      die "duplicate Claude profile key: $key"
    seen_keys+=("$key")
    normalize_claude_profile_value "$value" ||
      die "unmatched quote in Claude profile value: $key"
    value=$NORMALIZED_CLAUDE_PROFILE_VALUE

    case $key in
      ANTHROPIC_BASE_URL)
        [[ -n $value ]] || die "empty ANTHROPIC_BASE_URL"
        has_base=1
        ;;
      ANTHROPIC_AUTH_TOKEN)
        [[ -n $value ]] || die "empty ANTHROPIC_AUTH_TOKEN"
        has_auth_token=1
        ;;
      ANTHROPIC_API_KEY)
        [[ -n $value ]] || die "empty ANTHROPIC_API_KEY"
        has_api_key=1
        ;;
    esac
  done <"$file"

  if [[ $kind == official-api ]]; then
    ((has_api_key == 1 && has_auth_token == 0 && has_base == 0)) ||
      die "official API profile requires only ANTHROPIC_API_KEY"
  else
    ((has_base == 1 && has_auth_token + has_api_key == 1)) ||
      die "custom profile requires endpoint and exactly one credential"
  fi
}

validate_claude_profile_name() {
  [[ $CLAUDE_PROFILE_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid Claude profile name: $CLAUDE_PROFILE_NAME"
  [[ $CLAUDE_PROFILE_NAME != official-api ||
      $CLAUDE_CONNECTION == official-api ]] ||
    die "reserved Claude profile name: official-api"
}

read_masked_profile_value() {
  local prompt=$1
  local input_fd=0 output_fd=1
  local character='' read_status=0 tty_state='' value=''

  tty_state=$(stty -g <&"$input_fd") ||
    die "unable to read terminal state"
  trap 'stty "$tty_state" <&"$input_fd"' EXIT
  trap 'exit 130' HUP INT TERM
  stty -echo <&"$input_fd"
  printf '%s' "$prompt" >&"$output_fd"

  while :; do
    character=
    if ! IFS= read -r -n1 character <&"$input_fd"; then
      read_status=130
      break
    fi
    case $character in
      '')
        break
        ;;
      $'\003'|$'\033')
        read_status=130
        break
        ;;
      $'\010'|$'\177')
        if [[ -n $value ]]; then
          value=${value%?}
          printf '\b \b' >&"$output_fd"
        fi
        ;;
      *)
        value+=$character
        printf '*' >&"$output_fd"
        ;;
    esac
  done

  if [[ -n $tty_state ]]; then
    stty "$tty_state" <&"$input_fd"
    tty_state=
    trap - HUP INT TERM EXIT
  fi
  printf '\n' >&"$output_fd"
  ((read_status == 0)) || return "$read_status"
  MASKED_PROFILE_VALUE=$value
}

create_claude_profile() {
  local input_fd=0 output_fd=1
  local config_root profile_dir profile_path
  local profile_name endpoint api_key temp_file=

  if [[ ! -t $input_fd || ! -t $output_fd ]]; then
    die "--create-profile requires an interactive terminal"
  fi

  printf 'Profile 名称: ' >&"$output_fd"
  IFS= read -r profile_name <&"$input_fd" ||
    die "Profile name is required"
  [[ -n $profile_name ]] || die "Profile name is required"
  CLAUDE_PROFILE_NAME=$profile_name
  CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
  validate_claude_profile_name

  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$config_root"
  install -d -m 700 "$config_root/claude"
  install -d -m 700 "$config_root/claude/profiles"
  config_root=$(cd "$config_root" && pwd -P)
  profile_dir="$config_root/claude/profiles"
  profile_path="$profile_dir/$CLAUDE_PROFILE_NAME.env"
  if [[ -e $profile_path || -L $profile_path ]]; then
    die "Claude profile already exists: $profile_path"
  fi

  printf 'API endpoint: ' >&"$output_fd"
  IFS= read -r endpoint <&"$input_fd" ||
    die "API endpoint is required"
  [[ -n $endpoint ]] || die "API endpoint is required"

  MASKED_PROFILE_VALUE=
  read_masked_profile_value "API key: " ||
    return $?
  api_key=$MASKED_PROFILE_VALUE
  [[ -n $api_key ]] || die "API key is required"

  temp_file=$(mktemp "$profile_dir/.docker-agent-profile.XXXXXX") ||
    die "unable to create temporary profile"
  chmod 600 "$temp_file"
  trap '[[ -z ${temp_file:-} ]] || rm -f "$temp_file"' EXIT
  trap 'exit 130' HUP INT TERM
  printf '%s\n' \
    "ANTHROPIC_BASE_URL=$endpoint" \
    "ANTHROPIC_AUTH_TOKEN=$api_key" >"$temp_file"
  if ! ln "$temp_file" "$profile_path" 2>/dev/null; then
    die "Claude profile already exists: $profile_path"
  fi
  rm -f "$temp_file"
  temp_file=
  trap - EXIT HUP INT TERM

  validate_claude_profile "$profile_path" custom
  printf 'Profile 已创建：%s\n' "$profile_path" >&"$output_fd"
  printf '启动：docker-claude --profile %s\n' \
    "$CLAUDE_PROFILE_NAME" >&"$output_fd"
  printf '\n%s\n' \
    '************************************************************' \
    '⚠ 重要：尚未配置 ANTHROPIC_MODEL' \
    '未配置时将使用 Claude 默认模型名，自定义 endpoint 可能无法识别。' \
    "请编辑：$profile_path" \
    '添加：ANTHROPIC_MODEL=你的模型名称' \
    '如需配置其他模型映射或环境变量，也请编辑该文件。' \
    '************************************************************' >&"$output_fd"
}

resolve_claude_connection() {
  local expected_profile profile_dir

  [[ $CLAUDE_CONNECTION == official-subscription ]] && return 0

  CONFIG_ROOT=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$CONFIG_ROOT/claude/profiles"
  CONFIG_ROOT=$(cd "$CONFIG_ROOT" && pwd -P)
  path_is_within "$CONFIG_ROOT" "$CHECKOUT_ROOT" &&
    die "docker-agent config home must not be inside the checkout"

  case $CLAUDE_CONNECTION in
    official-api)
      expected_profile="$CONFIG_ROOT/claude/profiles/official-api.env"
      ;;
    profile:*)
      expected_profile="$CONFIG_ROOT/claude/profiles/$CLAUDE_PROFILE_NAME.env"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  profile_dir=$(cd "$(dirname "$expected_profile")" && pwd -P)
  CLAUDE_PROFILE_PATH="$profile_dir/$(basename "$expected_profile")"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CONFIG_ROOT" ||
    die "Claude profile resolves outside docker-agent config home"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CHECKOUT_ROOT" &&
    die "Claude profile must not be inside the checkout"

  if [[ $CLAUDE_CONNECTION == official-api ]]; then
    validate_claude_profile "$CLAUDE_PROFILE_PATH" official-api
  else
    validate_claude_profile "$CLAUDE_PROFILE_PATH" custom
  fi
}

validate_owned_mode_600_file() {
  local file=$1 label=$2
  [[ -e $file ]] || die "$label does not exist: $file"
  [[ ! -L $file ]] || die "$label must not be a symlink: $file"
  [[ -f $file ]] || die "$label must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "$label must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "$label must have mode 600: $file"
}

resolve_claude_credential_source() {
  local host_claude_home

  [[ $CLAUDE_CONNECTION == official-subscription ]] || return 0
  if [[ $HOST_OS == Darwin ]]; then
    die "host Claude subscription credentials are stored in macOS Keychain; use --official-api or --profile"
  fi

  host_claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  CLAUDE_CREDENTIAL_PATH="$host_claude_home/.credentials.json"
  validate_owned_mode_600_file \
    "$CLAUDE_CREDENTIAL_PATH" "Claude OAuth credential"
  CLAUDE_CREDENTIAL_PATH=$(
    cd "$(dirname "$CLAUDE_CREDENTIAL_PATH")" &&
      printf '%s/%s\n' "$(pwd -P)" "$(basename "$CLAUDE_CREDENTIAL_PATH")"
  )
}

slug_for() {
  local raw=$1 fallback=$2 slug
  slug=$(LC_ALL=C printf '%s' "$raw" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-48)
  [[ -n $slug ]] || slug=$fallback
  printf '%s\n' "$slug"
}

path_hash_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

ensure_state_identity() {
  local state_dir=$1 connection_id=$2
  local identity="$state_dir/.docker-agent-identity"
  local expected
  expected=$(mktemp)
  printf '%s\0' \
    "$COMMON_DIR" "$CHECKOUT_ROOT" claude "$connection_id" >"$expected"

  if [[ -L $identity || (-e $identity && ! -f $identity) ]]; then
    rm -f "$expected"
    die "Claude state identity must be a regular non-symlink file: $identity"
  fi
  if [[ -e $identity ]]; then
    if [[ $(file_uid "$identity") != "$(id -u)" ||
          $(file_mode "$identity") != 600 ]]; then
      rm -f "$expected"
      die "Claude state identity has unsafe metadata: $identity"
    fi
    cmp -s "$expected" "$identity" || {
      rm -f "$expected"
      die "Claude state identity does not match: $state_dir"
    }
  else
    install -m 600 "$expected" "$identity"
  fi
  rm -f "$expected"
}

prepare_claude_state() {
  local repo_name repo_id worktree_id state_base

  if [[ $(basename "$COMMON_DIR") == .git ]]; then
    repo_name=$(basename "$(dirname "$COMMON_DIR")")
  else
    repo_name=$(basename "$COMMON_DIR")
  fi
  repo_id="$(slug_for "$repo_name" repo)-$(path_hash_for "$COMMON_DIR")"
  worktree_id="$(slug_for "$(basename "$CHECKOUT_ROOT")" worktree)-$(path_hash_for "$CHECKOUT_ROOT")"
  state_base="$DATA_HOME/claude/repos/$repo_id/worktrees/$worktree_id"

  case $CLAUDE_CONNECTION in
    official-subscription|official-api)
      CLAUDE_STATE_DIR="$state_base/$CLAUDE_CONNECTION"
      ;;
    profile:*)
      CLAUDE_STATE_DIR="$state_base/profiles/${CLAUDE_CONNECTION#profile:}"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  install -d -m 700 "$CLAUDE_STATE_DIR"
  CLAUDE_STATE_DIR=$(cd "$CLAUDE_STATE_DIR" && pwd -P)
  ensure_state_identity "$CLAUDE_STATE_DIR" "$CLAUDE_CONNECTION"
}

# Optional per-agent hooks. An agent implements only the ones it needs:
# resolve_NAME_launch runs before any worktree is created, prepare_NAME_state
# runs once the final checkout and Git paths are known.
run_agent_hook() {
  local hook=$1
  if [[ $(type -t "$hook") == function ]]; then
    "$hook"
  fi
}

resolve_claude_launch() {
  if [[ -z $CLAUDE_CONNECTION ]]; then
    if [[ ${DOCKER_AGENT_TEST_FORCE_TTY:-} != 1 ]] &&
      { [[ ! -t 0 ]] || [[ ! -t 1 ]]; }; then
      die "non-interactive Claude launch requires --official-subscription, --official-api, or --profile NAME"
    fi
    if ! menu_select "请选择 Claude Code 的连接方式：" \
      "Anthropic 官方订阅 / OAuth" \
      "Anthropic 官方 API key" \
      "自定义 endpoint"; then
      exit 130
    fi
    case $MENU_SELECTION in
      0)
        CLAUDE_CONNECTION=official-subscription
        ;;
      1)
        CLAUDE_CONNECTION=official-api
        CLAUDE_PROFILE_NAME=official-api
        ;;
      2)
        choose_custom_profile_menu || exit 130
        ;;
    esac
    if [[ -n $CLAUDE_PROFILE_NAME ]]; then
      validate_claude_profile_name
    fi
  fi
  resolve_claude_connection
  resolve_claude_credential_source
}

prepare_claude_state_hook() {
  prepare_claude_state
}

# Codex reads its own login and config from CODEX_HOME, which the host shares
# with the container so a login on either side is visible to the other.
configure_codex_runtime() {
  local codex_home_source
  codex_home_source=${CODEX_HOME:-$HOME/.codex}
  [[ -d $codex_home_source ]] ||
    die "Codex home does not exist: $codex_home_source"
  codex_home_source=$(cd "$codex_home_source" && pwd -P)
  reject_mount_comma "$codex_home_source"
  DOCKER_ARGS+=(--env "CODEX_HOME=/codex-home")
  DOCKER_ARGS+=(--mount "type=bind,source=$codex_home_source,target=/codex-home")
}

configure_claude_runtime() {
  reject_mount_comma "$CLAUDE_STATE_DIR"
  DOCKER_ARGS+=(--mount "type=bind,source=$CLAUDE_STATE_DIR,target=/claude-state")
  DOCKER_ARGS+=(--env "CLAUDE_CONFIG_DIR=/claude-state")
  if [[ -n $CLAUDE_CREDENTIAL_PATH ]]; then
    append_file_mount \
      "$CLAUDE_CREDENTIAL_PATH" /claude-state/.credentials.json
  fi
  if [[ -n $CLAUDE_PROFILE_PATH ]]; then
    reject_mount_comma "$CLAUDE_PROFILE_PATH"
    DOCKER_ARGS+=(--mount "type=bind,source=$CLAUDE_PROFILE_PATH,target=/run/docker-agent/claude-profile.env,readonly")
    DOCKER_ARGS+=(--env "DOCKER_AGENT_CLAUDE_PROFILE_FILE=/run/docker-agent/claude-profile.env")
  fi
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CLAUDE_CONNECTION=$CLAUDE_CONNECTION")
}

# Kimi Code keeps config, sessions, and OAuth credentials under a single data
# root that KIMI_CODE_HOME relocates, so sharing that directory is enough to
# share a login. The directory is created when missing because the host does
# not need its own Kimi Code installation to run the container one.
configure_kimi_runtime() {
  local kimi_home_source
  kimi_home_source=${KIMI_CODE_HOME:-$HOME/.kimi-code}
  [[ $kimi_home_source == /* ]] ||
    die "Kimi Code home must be an absolute path: $kimi_home_source"
  if [[ -e $kimi_home_source && ! -d $kimi_home_source ]]; then
    die "Kimi Code home is not a directory: $kimi_home_source"
  fi
  install -d -m 700 "$kimi_home_source"
  kimi_home_source=$(cd "$kimi_home_source" && pwd -P)
  reject_mount_comma "$kimi_home_source"
  DOCKER_ARGS+=(--env "KIMI_CODE_HOME=/kimi-home")
  DOCKER_ARGS+=(--mount "type=bind,source=$kimi_home_source,target=/kimi-home")
}

codex_final_args() {
  FINAL_ARGS=(codex --yolo --disable apps "${AGENT_ARGS[@]}")
}

claude_final_args() {
  FINAL_ARGS=(claude "${AGENT_ARGS[@]}")
}

# Kimi Code rejects --yolo together with --prompt, --auto, or --plan, and its
# non-interactive mode already runs unattended, so the default is only added
# when the caller did not pick a mode itself.
kimi_selects_own_mode() {
  local arg
  for arg in "${AGENT_ARGS[@]}"; do
    case $arg in
      -p|--prompt|--prompt=*|-y|--yolo|--yes|--auto-approve|--auto|--plan)
        return 0
        ;;
    esac
  done
  return 1
}

kimi_final_args() {
  if kimi_selects_own_mode; then
    FINAL_ARGS=(kimi "${AGENT_ARGS[@]}")
  else
    FINAL_ARGS=(kimi --yolo "${AGENT_ARGS[@]}")
  fi
}

# Cursor Agent authenticates from CURSOR_API_KEY. Its own `status` and `whoami`
# subcommands only report the local OAuth login and ignore that variable, so a
# key cannot be verified before launching; the file is validated instead.
resolve_cursor_agent_launch() {
  local config_root key_dir
  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  key_dir="$config_root/cursor-agent"
  CURSOR_API_KEY_PATH="$key_dir/api-key"
  [[ -e $CURSOR_API_KEY_PATH ]] ||
    die "Cursor API key does not exist: $CURSOR_API_KEY_PATH
Generate a key at https://cursor.com/dashboard/api, then store it with:
  install -d -m 700 \"$key_dir\"
  install -m 600 /dev/null \"$CURSOR_API_KEY_PATH\"
  read -rs key && printf '%s' \"\$key\" > \"$CURSOR_API_KEY_PATH\" && unset key
Reading it with 'read -rs' keeps the key off the screen and out of shell history."
  validate_owned_mode_600_file "$CURSOR_API_KEY_PATH" "Cursor API key"
  [[ -s $CURSOR_API_KEY_PATH ]] ||
    die "Cursor API key file is empty: $CURSOR_API_KEY_PATH"
  CURSOR_API_KEY_PATH=$(
    cd "$(dirname "$CURSOR_API_KEY_PATH")" &&
      printf '%s/%s\n' "$(pwd -P)" "$(basename "$CURSOR_API_KEY_PATH")"
  )
}

configure_cursor_agent_runtime() {
  reject_mount_comma "$CURSOR_API_KEY_PATH"
  DOCKER_ARGS+=(--mount "type=bind,source=$CURSOR_API_KEY_PATH,target=/run/docker-agent/cursor-api-key,readonly")
  DOCKER_ARGS+=(--env "DOCKER_AGENT_CURSOR_API_KEY_FILE=/run/docker-agent/cursor-api-key")
}

cursor_agent_selects_own_mode() {
  local arg
  for arg in "${AGENT_ARGS[@]}"; do
    case $arg in
      -f|--force|--yolo|--auto-review)
        return 0
        ;;
    esac
  done
  return 1
}

# The CLI's own -w/--worktree creates the worktree under the container-private
# HOME, so its edits vanish with the container while the host repository keeps a
# prunable worktree registration and the new branch. The launcher still passes
# the flag through, but says so first.
warn_cursor_agent_worktree() {
  local arg
  for arg in "${AGENT_ARGS[@]}"; do
    case $arg in
      -w|--worktree|--worktree=*)
        cat >&2 <<'EOF'
================================================================================
WARNING: CURSOR AGENT WORKTREE / Cursor Agent 自带 worktree

-w/--worktree creates the worktree inside the container, so every edit made
there is lost when the container exits, and the host repository is left with a
prunable worktree entry plus the new branch.
该选项在容器内创建 worktree：容器退出后其中的修改全部丢失，宿主仓库则会
残留一条失效的 worktree 记录和新分支。

Use --isolated NAME instead to get a worktree that lives on the host.
请改用 --isolated NAME，它在宿主上创建可保留的 worktree。
================================================================================
EOF
        return 0
        ;;
    esac
  done
}

cursor_agent_final_args() {
  warn_cursor_agent_worktree
  # --disable-auto-update is a hidden flag; without it the pinned version in the
  # image can replace itself at runtime.
  if cursor_agent_selects_own_mode; then
    FINAL_ARGS=(cursor-agent --disable-auto-update "${AGENT_ARGS[@]}")
  else
    FINAL_ARGS=(cursor-agent --disable-auto-update --force "${AGENT_ARGS[@]}")
  fi
}


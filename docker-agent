# Agents are dispatched by name. Adding one means appending it here and
# defining the matching usage_SLUG, prepare_SLUG_launch, configure_SLUG_runtime,
# and SLUG_final_args functions, where SLUG is the agent name with every hyphen
# replaced by an underscore so it is a portable function-name component.
SUPPORTED_AGENTS="codex claude kimi cursor-agent"

agent_is_supported() {
  local candidate=$1 name
  for name in $SUPPORTED_AGENTS; do
    [[ $name == "$candidate" ]] && return 0
  done
  return 1
}

case $PROGRAM_NAME in
  docker-agent)
    case ${1:-} in
      -h|--help)
        usage_agent
        exit 0
        ;;
    esac
    (($# >= 1)) || die "expected agent: ${SUPPORTED_AGENTS// /, }"
    AGENT=$1
    shift
    ;;
  docker-*)
    AGENT=${PROGRAM_NAME#docker-}
    ;;
  *)
    die "unsupported launcher name: $PROGRAM_NAME"
    ;;
esac
agent_is_supported "$AGENT" || die "unsupported agent: $AGENT"
AGENT_SLUG=${AGENT//-/_}

path_is_within() {
  local child=$1 parent=$2
  if [[ $parent == / ]]; then
    return 0
  fi
  [[ $child == "$parent" || $child == "$parent/"* ]]
}

git_metadata_dir() {
  local checkout=$1 option=$2 path
  path=$(git -C "$checkout" rev-parse "$option")
  if [[ $path != /* ]]; then
    path="$checkout/$path"
  fi
  (cd "$path" && pwd -P)
}

file_uid() {
  if stat -c %u "$1" >/dev/null 2>&1; then
    stat -c %u "$1"
  else
    stat -f %u "$1"
  fi
}

file_gid() {
  if stat -c %g "$1" >/dev/null 2>&1; then
    stat -c %g "$1"
  else
    stat -f %g "$1"
  fi
}

file_mode() {
  if stat -c %a "$1" >/dev/null 2>&1; then
    stat -c %a "$1"
  else
    stat -f %Lp "$1"
  fi
}

array_contains() {
  local needle=$1 item
  shift
  for item in "$@"; do
    [[ $item == "$needle" ]] && return 0
  done
  return 1
}

reject_mount_comma() {
  [[ $1 != *,* ]] ||
    die "Docker --mount paths containing commas are unsupported: $1"
}

resolve_codex_home() {
  local host_home_physical requested
  [[ -z ${CODEX_HOME_LOGICAL:-} ]] || return 0
  requested=${CODEX_HOME:-$HOME/.codex}
  [[ $requested == /* ]] ||
    die "Codex home must be an absolute path: $requested"
  [[ -e $requested ]] || die "Codex home does not exist: $requested"
  [[ -d $requested ]] || die "Codex home is not a directory: $requested"

  CODEX_HOME_LOGICAL=$(cd -L "$requested" && pwd -L)
  CODEX_HOME_PHYSICAL=$(cd -P "$requested" && pwd -P)
  [[ $CODEX_HOME_PHYSICAL != / ]] ||
    die "Codex home must not resolve to the host filesystem root"
  host_home_physical=$(cd -P "$HOME" && pwd -P)
  if path_is_within "$host_home_physical" "$CODEX_HOME_PHYSICAL"; then
    die "Codex home must not contain the complete host home: $CODEX_HOME_LOGICAL"
  fi
  case $CODEX_HOME_LOGICAL in
    /codex-cache|/codex-credentials|/codex-credentials/*|/home/codex|/run/docker-agent|/run/docker-agent/*)
      die "Codex home conflicts with a reserved container path: $CODEX_HOME_LOGICAL"
      ;;
  esac
  reject_mount_comma "$CODEX_HOME_LOGICAL"
  reject_mount_comma "$CODEX_HOME_PHYSICAL"
}

append_same_path_mount() {
  local path=$1 mode=${2:-rw}
  [[ -e $path ]] || die "bind source does not exist: $path"
  [[ -d $path ]] || die "bind source must be a directory: $path"
  path=$(cd "$path" && pwd -P)
  reject_mount_comma "$path"
  if [[ $mode == ro ]]; then
    DOCKER_ARGS+=(--mount "type=bind,source=$path,target=$path,readonly")
  else
    DOCKER_ARGS+=(--mount "type=bind,source=$path,target=$path")
  fi
}

append_file_mount() {
  local source=$1 target=$2 mode=${3:-rw}
  reject_mount_comma "$source"
  if [[ $mode == ro ]]; then
    DOCKER_ARGS+=(--mount "type=bind,source=$source,target=$target,readonly")
  else
    DOCKER_ARGS+=(--mount "type=bind,source=$source,target=$target")
  fi
}

validate_env_spec() {
  local spec=$1 name
  name=${spec%%=*}
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
    die "invalid environment variable name: $name"
  if [[ $spec != *=* ]] && ! printenv "$name" >/dev/null 2>&1; then
    die "host environment variable is not set: $name"
  fi
  VALIDATED_ENV_NAME=$name
}


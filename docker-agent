#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME=$(basename "$0")

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

usage_agent() {
  cat <<'EOF'
Usage: docker-agent {codex|claude|kimi|cursor-agent} [options] [--] [agent args...]

Run Codex, Claude Code, Kimi Code, or Cursor Agent in Docker against the
current project directory.

Commands:
  docker-agent codex         Run Codex
  docker-agent claude        Run Claude Code
  docker-agent kimi          Run Kimi Code
  docker-agent cursor-agent  Run Cursor Agent

Use "docker-agent AGENT --help" for agent-specific options.
EOF
}


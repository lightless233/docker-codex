repo_id_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

launcher_has_tty() {
  [[ ${DOCKER_AGENT_TEST_FORCE_TTY:-} == 1 ]] && return 0
  [[ -t 0 && -t 1 ]]
}

parse_origin_host() {
  local url=$1
  case $url in
    git@*:*)
      url=${url#git@}
      printf '%s\n' "${url%%:*}"
      ;;
    ssh://*)
      url=${url#ssh://}
      url=${url#*@}
      printf '%s\n' "${url%%/*}"
      ;;
    http://*|https://*)
      url=${url#*://}
      printf '%s\n' "${url%%/*}"
      ;;
    *)
      return 1
      ;;
  esac
}

validate_isolated_name() {
  local name=$1
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid isolated worktree name: $name"
  git check-ref-format --branch "codex/$name" >/dev/null 2>&1 ||
    die "invalid isolated worktree name: $name"
}

create_isolated_worktree() {
  local name=$1 current_branch repo_id target branch
  validate_isolated_name "$name"
  current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [[ -n $current_branch ]] ||
    die "--isolated requires the current checkout to be on a branch"

  mkdir -p "$DATA_HOME/worktrees"
  DATA_HOME=$(cd "$DATA_HOME" && pwd -P)
  repo_id=$(repo_id_for "$COMMON_DIR")
  target="$DATA_HOME/worktrees/$repo_id/$name"
  branch="codex/$name"

  [[ ! -e $target ]] ||
    die "isolated worktree path already exists: $target"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    die "isolated worktree branch already exists: $branch"
  fi

  mkdir -p "$(dirname "$target")"
  git worktree add -b "$branch" "$target" HEAD
  CHECKOUT_ROOT=$(cd "$target" && pwd -P)
  START_DIR=$CHECKOUT_ROOT
}

select_claude_connection() {
  local selected=$1
  [[ $AGENT == claude ]] ||
    die "$selected is only valid for Claude"
  [[ -z $CLAUDE_CONNECTION ]] ||
    die "Claude connection selectors are mutually exclusive"
  CLAUDE_CONNECTION=${selected#--}
}

menu_select() {
  local prompt=$1
  shift
  (($# > 0)) || return 1
  local options=("$@")
  local index=0 key escape_sequence i
  local input_fd=${DOCKER_AGENT_MENU_INPUT_FD:-0}
  local output_fd=${DOCKER_AGENT_MENU_OUTPUT_FD:-1}
  local escape_timeout=0.1

  # Bash 3.2 accepts only whole seconds for `read -t`.
  ((BASH_VERSINFO[0] >= 4)) || escape_timeout=1

  while :; do
    printf '\033[2J\033[H%s\n\n' "$prompt" >&"$output_fd"
    for ((i = 0; i < ${#options[@]}; i++)); do
      if ((i == index)); then
        printf '❯ %s\n' "${options[$i]}" >&"$output_fd"
      else
        printf '  %s\n' "${options[$i]}" >&"$output_fd"
      fi
    done
    printf '\n↑/↓ 选择 · Enter 确认 · Esc 取消\n' >&"$output_fd"

    if ! IFS= read -rsn1 key <&"$input_fd"; then
      return 130
    fi
    case $key in
      '')
        MENU_SELECTION=$index
        return 0
        ;;
      j)
        index=$(((index + 1) % ${#options[@]}))
        ;;
      k)
        index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
        ;;
      $'\003')
        return 130
        ;;
      $'\033')
        escape_sequence=
        if ! IFS= read -rsn2 -t "$escape_timeout" escape_sequence \
          <&"$input_fd"; then
          return 130
        fi
        case $escape_sequence in
          '[A')
            index=$(((index + ${#options[@]} - 1) % ${#options[@]}))
            ;;
          '[B')
            index=$(((index + 1) % ${#options[@]}))
            ;;
          *)
            return 130
            ;;
        esac
        ;;
    esac
  done
}

normalize_claude_profile_value() {
  local value=$1 first last

  NORMALIZED_CLAUDE_PROFILE_VALUE=$value
  [[ -n $value ]] || return 0
  first=${value:0:1}
  last=${value: -1}
  if [[ $first == \" || $first == \' || $last == \" || $last == \' ]]; then
    ((${#value} >= 2)) &&
      [[ $first == "$last" && ( $first == \" || $first == \' ) ]] ||
      return 1
    value=${value:1}
    NORMALIZED_CLAUDE_PROFILE_VALUE=${value%?}
  fi
}

claude_profile_model_summary() {
  local file=$1 line model sanitized

  if [[ -f $file && ! -L $file && -r $file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == ANTHROPIC_MODEL=* ]] || continue
      model=${line#*=}
      if ! normalize_claude_profile_value "$model"; then
        break
      fi
      model=$NORMALIZED_CLAUDE_PROFILE_VALUE
      if [[ -n $model ]]; then
        sanitized=$(printf '%s' "$model" | LC_ALL=C tr -d '[:cntrl:]')
        if [[ -n $sanitized ]]; then
          if ((${#sanitized} > 64)); then
            sanitized="${sanitized:0:61}..."
          fi
          printf '主模型: %s\n' "$sanitized"
          return
        fi
      fi
      break
    done <"$file"
  fi

  printf '⚠ 主模型未配置：将使用 Claude 默认模型名\n'
}

choose_custom_profile_menu() {
  local config_root profile_dir file name summary
  local profile_names=()
  local profile_labels=()

  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  profile_dir="$config_root/claude/profiles"
  if [[ -d $profile_dir ]]; then
    while IFS= read -r name; do
      if [[ -n $name ]]; then
        profile_names+=("$name")
        summary=$(claude_profile_model_summary "$profile_dir/$name.env")
        profile_labels+=("$name  [$summary]")
      fi
    done < <(
      shopt -s nullglob
      for file in "$profile_dir"/*.env; do
        name=$(basename "$file" .env)
        [[ $name == official-api ]] && continue
        [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        printf '%s\n' "$name"
      done | LC_ALL=C sort
    )
  fi

  if [[ ${profile_names[0]+set} != set ]]; then
    die "no custom Claude profiles found in: $profile_dir
Create one with:
  install -d -m 700 \"$profile_dir\"
  install -m 600 /dev/null \"$profile_dir/NAME.env\""
  fi

  menu_select "请选择自定义 endpoint profile：" "${profile_labels[@]}" ||
    return 130
  CLAUDE_PROFILE_NAME=${profile_names[$MENU_SELECTION]}
  CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
}

validate_claude_profile() {
  local file=$1 kind=$2
  local line key value
  local seen_keys=()
  local has_base=0 has_auth_token=0 has_api_key=0

  [[ -e $file ]] || die "Claude profile does not exist: $file"
  [[ ! -L $file ]] || die "Claude profile must not be a symlink: $file"
  [[ -f $file ]] || die "Claude profile must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "Claude profile must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "Claude profile must have mode 600: $file"

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line == *=* ]] || die "invalid Claude profile assignment"
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
      die "invalid Claude profile key: $key"
    # Bash 3.2 treats a zero-element array as unset under `set -u`.
    array_contains "$key" ${seen_keys[@]+"${seen_keys[@]}"} &&
      die "duplicate Claude profile key: $key"
    seen_keys+=("$key")
    normalize_claude_profile_value "$value" ||
      die "unmatched quote in Claude profile value: $key"
    value=$NORMALIZED_CLAUDE_PROFILE_VALUE

    case $key in
      ANTHROPIC_BASE_URL)
        [[ -n $value ]] || die "empty ANTHROPIC_BASE_URL"
        has_base=1
        ;;
      ANTHROPIC_AUTH_TOKEN)
        [[ -n $value ]] || die "empty ANTHROPIC_AUTH_TOKEN"
        has_auth_token=1
        ;;
      ANTHROPIC_API_KEY)
        [[ -n $value ]] || die "empty ANTHROPIC_API_KEY"
        has_api_key=1
        ;;
    esac
  done <"$file"

  if [[ $kind == official-api ]]; then
    ((has_api_key == 1 && has_auth_token == 0 && has_base == 0)) ||
      die "official API profile requires only ANTHROPIC_API_KEY"
  else
    ((has_base == 1 && has_auth_token + has_api_key == 1)) ||
      die "custom profile requires endpoint and exactly one credential"
  fi
}

validate_claude_profile_name() {
  [[ $CLAUDE_PROFILE_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid Claude profile name: $CLAUDE_PROFILE_NAME"
  [[ $CLAUDE_PROFILE_NAME != official-api ||
      $CLAUDE_CONNECTION == official-api ]] ||
    die "reserved Claude profile name: official-api"
}

validate_codex_profile_name() {
  [[ $CODEX_PROFILE_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid Codex profile name: $CODEX_PROFILE_NAME"
}

resolve_codex_profile_root() {
  local checkout_root=

  CONFIG_ROOT=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$CONFIG_ROOT"
  install -d -m 700 "$CONFIG_ROOT/codex"
  install -d -m 700 "$CONFIG_ROOT/codex/profiles"
  CONFIG_ROOT=$(cd "$CONFIG_ROOT" && pwd -P)
  CODEX_PROFILE_ROOT=$(cd "$CONFIG_ROOT/codex/profiles" && pwd -P)
  path_is_within "$CODEX_PROFILE_ROOT" "$CONFIG_ROOT" ||
    die "Codex profile directory resolves outside docker-agent config home"

  if [[ -n ${CHECKOUT_ROOT:-} ]]; then
    checkout_root=$CHECKOUT_ROOT
  elif command -v git >/dev/null 2>&1 &&
      checkout_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    checkout_root=$(cd "$checkout_root" && pwd -P)
  fi
  if [[ -n $checkout_root ]]; then
    path_is_within "$CONFIG_ROOT" "$checkout_root" &&
      die "docker-agent config home must not be inside the checkout"
    path_is_within "$CODEX_PROFILE_ROOT" "$checkout_root" &&
      die "Codex profile must not be inside the checkout"
  fi
  path_is_within "$CODEX_PROFILE_ROOT" "$CODEX_HOME_PHYSICAL" &&
    die "Codex profile directory must not be inside CODEX_HOME"
  return 0
}

toml_basic_string() {
  local value=$1
  if LC_ALL=C printf '%s' "$value" | grep -q '[[:cntrl:]]'; then
    return 1
  fi
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

read_masked_profile_value() {
  local prompt=$1
  local input_fd=0 output_fd=1
  local character='' read_status=0 tty_state='' value=''

  tty_state=$(stty -g <&"$input_fd") ||
    die "unable to read terminal state"
  trap 'stty "$tty_state" <&"$input_fd"' EXIT
  trap 'exit 130' HUP INT TERM
  stty -echo <&"$input_fd"
  printf '%s' "$prompt" >&"$output_fd"

  while :; do
    character=
    if ! IFS= read -r -n1 character <&"$input_fd"; then
      read_status=130
      break
    fi
    case $character in
      '')
        break
        ;;
      $'\003'|$'\033')
        read_status=130
        break
        ;;
      $'\010'|$'\177')
        if [[ -n $value ]]; then
          value=${value%?}
          printf '\b \b' >&"$output_fd"
        fi
        ;;
      *)
        value+=$character
        printf '*' >&"$output_fd"
        ;;
    esac
  done

  if [[ -n $tty_state ]]; then
    stty "$tty_state" <&"$input_fd"
    tty_state=
    trap - HUP INT TERM EXIT
  fi
  printf '\n' >&"$output_fd"
  ((read_status == 0)) || return "$read_status"
  MASKED_PROFILE_VALUE=$value
}

create_claude_profile() {
  local input_fd=0 output_fd=1
  local config_root profile_dir profile_path
  local profile_name endpoint api_key temp_file=

  if [[ ! -t $input_fd || ! -t $output_fd ]]; then
    die "--create-profile requires an interactive terminal"
  fi

  printf 'Profile 名称: ' >&"$output_fd"
  IFS= read -r profile_name <&"$input_fd" ||
    die "Profile name is required"
  [[ -n $profile_name ]] || die "Profile name is required"
  CLAUDE_PROFILE_NAME=$profile_name
  CLAUDE_CONNECTION="profile:$CLAUDE_PROFILE_NAME"
  validate_claude_profile_name

  config_root=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$config_root"
  install -d -m 700 "$config_root/claude"
  install -d -m 700 "$config_root/claude/profiles"
  config_root=$(cd "$config_root" && pwd -P)
  profile_dir="$config_root/claude/profiles"
  profile_path="$profile_dir/$CLAUDE_PROFILE_NAME.env"
  if [[ -e $profile_path || -L $profile_path ]]; then
    die "Claude profile already exists: $profile_path"
  fi

  printf 'API endpoint: ' >&"$output_fd"
  IFS= read -r endpoint <&"$input_fd" ||
    die "API endpoint is required"
  [[ -n $endpoint ]] || die "API endpoint is required"

  MASKED_PROFILE_VALUE=
  read_masked_profile_value "API key: " ||
    return $?
  api_key=$MASKED_PROFILE_VALUE
  [[ -n $api_key ]] || die "API key is required"

  temp_file=$(mktemp "$profile_dir/.docker-agent-profile.XXXXXX") ||
    die "unable to create temporary profile"
  chmod 600 "$temp_file"
  trap '[[ -z ${temp_file:-} ]] || rm -f "$temp_file"' EXIT
  trap 'exit 130' HUP INT TERM
  printf '%s\n' \
    "ANTHROPIC_BASE_URL=$endpoint" \
    "ANTHROPIC_AUTH_TOKEN=$api_key" >"$temp_file"
  if ! ln "$temp_file" "$profile_path" 2>/dev/null; then
    die "Claude profile already exists: $profile_path"
  fi
  rm -f "$temp_file"
  temp_file=
  trap - EXIT HUP INT TERM

  validate_claude_profile "$profile_path" custom
  printf 'Profile 已创建：%s\n' "$profile_path" >&"$output_fd"
  printf '启动：docker-claude --profile %s\n' \
    "$CLAUDE_PROFILE_NAME" >&"$output_fd"
  printf '\n%s\n' \
    '************************************************************' \
    '⚠ 重要：尚未配置 ANTHROPIC_MODEL' \
    '未配置时将使用 Claude 默认模型名，自定义 endpoint 可能无法识别。' \
    "请编辑：$profile_path" \
    '添加：ANTHROPIC_MODEL=你的模型名称' \
    '如需配置其他模型映射或环境变量，也请编辑该文件。' \
    '************************************************************' >&"$output_fd"
}

create_codex_profile() {
  local input_fd=0 output_fd=1
  local profile_dir profile_path profile_link compat_path provider_id checkout_root
  local profile_name endpoint model api_key temp_dir='' temp_file=
  local created_profile_dir='' created_profile_link='' created_compat_link=''
  local quoted_profile quoted_provider quoted_endpoint quoted_model quoted_key

  if [[ ! -t $input_fd || ! -t $output_fd ]]; then
    die "--create-profile requires an interactive terminal"
  fi

  resolve_codex_home
  if command -v git >/dev/null 2>&1 &&
      checkout_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    checkout_root=$(cd "$checkout_root" && pwd -P)
    path_is_within "$CODEX_HOME_PHYSICAL" "$checkout_root" &&
      die "Codex profiles must not be stored inside the checkout"
  fi

  printf 'Profile 名称: ' >&"$output_fd"
  IFS= read -r profile_name <&"$input_fd" ||
    die "Profile name is required"
  [[ -n $profile_name ]] || die "Profile name is required"
  CODEX_PROFILE_NAME=$profile_name
  validate_codex_profile_name

  resolve_codex_profile_root
  profile_dir="$CODEX_PROFILE_ROOT/$CODEX_PROFILE_NAME"
  profile_path="$profile_dir/config.toml"
  profile_link="$CODEX_PROFILE_ROOT/$CODEX_PROFILE_NAME.config.toml"
  compat_path="$CODEX_HOME_LOGICAL/$CODEX_PROFILE_NAME.config.toml"
  if [[ -e $profile_dir || -L $profile_dir ||
        -e $profile_link || -L $profile_link ]]; then
    die "Codex profile already exists: $profile_link"
  fi
  if [[ -e $compat_path || -L $compat_path ]]; then
    die "native Codex profile path already exists: $compat_path"
  fi

  printf 'API endpoint: ' >&"$output_fd"
  IFS= read -r endpoint <&"$input_fd" ||
    die "API endpoint is required"
  [[ -n $endpoint ]] || die "API endpoint is required"

  printf '模型名称: ' >&"$output_fd"
  IFS= read -r model <&"$input_fd" ||
    die "Model name is required"
  [[ -n $model ]] || die "Model name is required"

  MASKED_PROFILE_VALUE=
  read_masked_profile_value "API key: " ||
    return $?
  api_key=$MASKED_PROFILE_VALUE
  [[ -n $api_key ]] || die "API key is required"

  provider_id="docker-agent-$CODEX_PROFILE_NAME"
  quoted_profile=$(toml_basic_string "$CODEX_PROFILE_NAME") ||
    die "Codex profile name contains unsupported control characters"
  quoted_provider=$(toml_basic_string "$provider_id") ||
    die "Codex provider id contains unsupported control characters"
  quoted_endpoint=$(toml_basic_string "$endpoint") ||
    die "API endpoint contains unsupported control characters"
  quoted_model=$(toml_basic_string "$model") ||
    die "Model name contains unsupported control characters"
  quoted_key=$(toml_basic_string "$api_key") ||
    die "API key contains unsupported control characters"

  temp_dir=$(mktemp -d "$CODEX_PROFILE_ROOT/.docker-agent-codex-profile.XXXXXX") ||
    die "unable to create temporary Codex profile directory"
  chmod 700 "$temp_dir"
  temp_file=$temp_dir/config.toml
  install -m 600 /dev/null "$temp_file"
  trap '[[ -z ${created_compat_link:-} ]] || rm -f "$created_compat_link"
        [[ -z ${created_profile_link:-} ]] || rm -f "$created_profile_link"
        [[ -z ${created_profile_dir:-} ]] || rm -rf "$created_profile_dir"
        [[ -z ${temp_dir:-} ]] || rm -rf "$temp_dir"' EXIT
  trap 'exit 130' HUP INT TERM
  printf '%s\n' \
    "model_provider = $quoted_provider" \
    "model = $quoted_model" \
    "review_model = $quoted_model" \
    '' \
    "[model_providers.$quoted_provider]" \
    "name = $quoted_profile" \
    "base_url = $quoted_endpoint" \
    'wire_api = "responses"' \
    "experimental_bearer_token = $quoted_key" >"$temp_file"
  if ! mkdir -m 700 "$profile_dir" 2>/dev/null; then
    die "Codex profile already exists: $profile_link"
  fi
  created_profile_dir=$profile_dir
  mv "$temp_file" "$profile_path"
  temp_file=
  rmdir "$temp_dir"
  temp_dir=
  if ! ln -s "$profile_path" "$profile_link" 2>/dev/null; then
    die "Codex profile already exists: $profile_link"
  fi
  created_profile_link=$profile_link
  if ! ln -s "$profile_path" "$compat_path" 2>/dev/null; then
    die "native Codex profile path already exists: $compat_path"
  fi
  created_compat_link=$compat_path
  api_key=
  MASKED_PROFILE_VALUE=
  quoted_key=

  validate_owned_mode_600_file "$profile_path" "Codex profile"
  [[ -L $profile_link && $(readlink "$profile_link") == "$profile_path" ]] ||
    die "unable to create managed Codex profile link"
  [[ -L $compat_path && $(readlink "$compat_path") == "$profile_path" ]] ||
    die "unable to create native Codex profile compatibility link"
  created_compat_link=
  created_profile_link=
  created_profile_dir=
  trap - EXIT HUP INT TERM
  printf 'Profile 已创建：%s\n' "$profile_link" >&"$output_fd"
  printf '启动：docker-codex --profile %s\n' \
    "$CODEX_PROFILE_NAME" >&"$output_fd"
}

resolve_claude_connection() {
  local expected_profile profile_dir

  [[ $CLAUDE_CONNECTION == official-subscription ]] && return 0

  CONFIG_ROOT=${DOCKER_AGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/docker-agent}
  install -d -m 700 "$CONFIG_ROOT/claude/profiles"
  CONFIG_ROOT=$(cd "$CONFIG_ROOT" && pwd -P)
  path_is_within "$CONFIG_ROOT" "$CHECKOUT_ROOT" &&
    die "docker-agent config home must not be inside the checkout"

  case $CLAUDE_CONNECTION in
    official-api)
      expected_profile="$CONFIG_ROOT/claude/profiles/official-api.env"
      ;;
    profile:*)
      expected_profile="$CONFIG_ROOT/claude/profiles/$CLAUDE_PROFILE_NAME.env"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  profile_dir=$(cd "$(dirname "$expected_profile")" && pwd -P)
  CLAUDE_PROFILE_PATH="$profile_dir/$(basename "$expected_profile")"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CONFIG_ROOT" ||
    die "Claude profile resolves outside docker-agent config home"
  path_is_within "$CLAUDE_PROFILE_PATH" "$CHECKOUT_ROOT" &&
    die "Claude profile must not be inside the checkout"

  if [[ $CLAUDE_CONNECTION == official-api ]]; then
    validate_claude_profile "$CLAUDE_PROFILE_PATH" official-api
  else
    validate_claude_profile "$CLAUDE_PROFILE_PATH" custom
  fi
}

validate_owned_mode_600_file() {
  local file=$1 label=$2
  [[ -e $file ]] || die "$label does not exist: $file"
  [[ ! -L $file ]] || die "$label must not be a symlink: $file"
  [[ -f $file ]] || die "$label must be a regular file: $file"
  [[ $(file_uid "$file") == "$(id -u)" ]] ||
    die "$label must be owned by the current user: $file"
  [[ $(file_mode "$file") == 600 ]] ||
    die "$label must have mode 600: $file"
}

validate_owned_mode_700_directory() {
  local directory=$1 label=$2
  [[ -e $directory ]] || die "$label does not exist: $directory"
  [[ ! -L $directory ]] || die "$label must not be a symlink: $directory"
  [[ -d $directory ]] || die "$label must be a directory: $directory"
  [[ $(file_uid "$directory") == "$(id -u)" ]] ||
    die "$label must be owned by the current user: $directory"
  [[ $(file_mode "$directory") == 700 ]] ||
    die "$label must have mode 700: $directory"
}

physical_symlink_target() {
  local link=$1 target target_dir
  target=$(readlink "$link") || return 1
  if [[ $target != /* ]]; then
    target="$(dirname "$link")/$target"
  fi
  target_dir=$(dirname "$target")
  [[ -d $target_dir ]] || return 1
  target_dir=$(cd -P "$target_dir" && pwd -P) || return 1
  printf '%s/%s\n' "$target_dir" "$(basename "$target")"
}

replace_symlink() {
  local link=$1 target=$2 label=$3
  local temporary_link="$link.docker-agent-$$"

  [[ ! -e $temporary_link && ! -L $temporary_link ]] ||
    die "$label temporary path already exists: $temporary_link"
  ln -s "$target" "$temporary_link" 2>/dev/null ||
    die "unable to create $label: $link"
  if ! mv -f "$temporary_link" "$link" 2>/dev/null; then
    rm -f "$temporary_link"
    die "unable to replace $label: $link"
  fi
}

migrate_flat_managed_codex_profile() {
  local profile_link=$1 profile_dir=$2 profile_path=$3
  local temporary_profile="$profile_dir/.config.toml.docker-agent-$$"

  validate_owned_mode_600_file "$profile_link" "Codex profile"
  if [[ -e $profile_dir || -L $profile_dir ]]; then
    validate_owned_mode_700_directory "$profile_dir" "Codex profile directory"
    [[ -f $profile_path && ! -L $profile_path ]] ||
      die "incomplete managed Codex profile migration: $profile_link"
    cmp -s "$profile_link" "$profile_path" ||
      die "conflicting managed Codex profile layouts: $profile_link"
  else
    install -d -m 700 "$profile_dir"
    install -m 600 "$profile_link" "$temporary_profile"
    mv "$temporary_profile" "$profile_path"
  fi
  replace_symlink "$profile_link" "$profile_path" "managed Codex profile link"
  printf 'docker-codex: migrated managed profile layout: %s\n' \
    "$profile_link" >&2
}

resolve_managed_codex_profile() {
  local profile_link="$CODEX_PROFILE_ROOT/$CODEX_PROFILE_NAME.config.toml"
  local profile_dir="$CODEX_PROFILE_ROOT/$CODEX_PROFILE_NAME"
  local profile_path="$profile_dir/config.toml"
  local resolved_target

  if [[ -f $profile_link && ! -L $profile_link ]]; then
    migrate_flat_managed_codex_profile \
      "$profile_link" "$profile_dir" "$profile_path"
  elif [[ -e $profile_link && ! -L $profile_link ]]; then
    die "Codex profile must be a regular file or managed link: $profile_link"
  fi

  if [[ ! -e $profile_link && ! -L $profile_link ]]; then
    if [[ ! -e $profile_dir && ! -L $profile_dir ]]; then
      return 1
    fi
    validate_owned_mode_700_directory "$profile_dir" "Codex profile directory"
    validate_owned_mode_600_file "$profile_path" "Codex profile"
    replace_symlink "$profile_link" "$profile_path" "managed Codex profile link"
  fi

  [[ -L $profile_link ]] ||
    die "managed Codex profile path must be a symlink: $profile_link"
  [[ $(file_uid "$profile_link") == "$(id -u)" ]] ||
    die "managed Codex profile link must be owned by the current user: $profile_link"
  resolved_target=$(physical_symlink_target "$profile_link") ||
    die "managed Codex profile link target does not exist: $profile_link"
  [[ $resolved_target == "$profile_path" ]] ||
    die "managed Codex profile link points to a different file: $profile_link"
  validate_owned_mode_700_directory "$profile_dir" "Codex profile directory"
  validate_owned_mode_600_file "$profile_path" "Codex profile"

  CODEX_PROFILE_PUBLIC_PATH=$profile_link
  CODEX_PROFILE_DIR=$profile_dir
  CODEX_PROFILE_PATH=$profile_path
}

migrate_codex_profile_deprecated_features() {
  local feature_state has_legacy has_hooks temporary_profile

  # Avoid interpreting apparent table headers inside TOML multiline strings.
  # Managed profiles created by this launcher never need multiline strings;
  # leave hand-written complex profiles untouched and let Codex report the
  # deprecated key for manual migration.
  if grep -Fq '"""' "$CODEX_PROFILE_PATH" ||
     grep -Fq "'''" "$CODEX_PROFILE_PATH"; then
    if grep -Fq 'codex_hooks' "$CODEX_PROFILE_PATH"; then
      printf 'docker-codex: warning: replace features.codex_hooks with features.hooks manually in complex profile: %s\n' \
        "$CODEX_PROFILE_PUBLIC_PATH" >&2
    fi
    return 0
  fi

  feature_state=$(awk '
    /^[[:space:]]*\[[[:space:]]*features[[:space:]]*\][[:space:]]*(#.*)?$/ {
      in_features = 1
      next
    }
    /^[[:space:]]*\[/ { in_features = 0 }
    in_features && /^[[:space:]]*codex_hooks[[:space:]]*=/ { legacy = 1 }
    in_features && /^[[:space:]]*hooks[[:space:]]*=/ { modern = 1 }
    !in_features && /^[[:space:]]*features[.]codex_hooks[[:space:]]*=/ { legacy = 1 }
    !in_features && /^[[:space:]]*features[.]hooks[[:space:]]*=/ { modern = 1 }
    END { printf "%d %d\n", legacy, modern }
  ' "$CODEX_PROFILE_PATH") ||
    die "unable to inspect Codex profile features: $CODEX_PROFILE_PUBLIC_PATH"
  IFS=' ' read -r has_legacy has_hooks <<<"$feature_state"
  [[ $has_legacy == 1 ]] || return 0

  temporary_profile="$CODEX_PROFILE_DIR/.config.toml.docker-agent-$$"
  install -m 600 /dev/null "$temporary_profile"
  if ! awk -v has_hooks="$has_hooks" '
      /^[[:space:]]*\[[[:space:]]*features[[:space:]]*\][[:space:]]*(#.*)?$/ {
        in_features = 1
        print
        next
      }
      /^[[:space:]]*\[/ { in_features = 0 }
      in_features && /^[[:space:]]*codex_hooks[[:space:]]*=/ {
        if (!has_hooks) {
          sub(/codex_hooks/, "hooks")
          print
        }
        next
      }
      !in_features && /^[[:space:]]*features[.]codex_hooks[[:space:]]*=/ {
        if (!has_hooks) {
          sub(/features[.]codex_hooks/, "features.hooks")
          print
        }
        next
      }
      { print }
    ' "$CODEX_PROFILE_PATH" >"$temporary_profile"; then
    rm -f "$temporary_profile"
    die "unable to migrate Codex profile features: $CODEX_PROFILE_PUBLIC_PATH"
  fi
  mv "$temporary_profile" "$CODEX_PROFILE_PATH"
  printf 'docker-codex: migrated features.codex_hooks to features.hooks: %s\n' \
    "$CODEX_PROFILE_PUBLIC_PATH" >&2
}

ensure_codex_native_profile_link() {
  local resolved_target direct_target

  if [[ ! -e $CODEX_PROFILE_COMPAT_PATH &&
        ! -L $CODEX_PROFILE_COMPAT_PATH ]]; then
    replace_symlink "$CODEX_PROFILE_COMPAT_PATH" "$CODEX_PROFILE_PATH" \
      "native Codex profile link"
  fi
  [[ -L $CODEX_PROFILE_COMPAT_PATH ]] ||
    die "native Codex profile path conflicts with managed profile: $CODEX_PROFILE_COMPAT_PATH"
  [[ $(file_uid "$CODEX_PROFILE_COMPAT_PATH") == "$(id -u)" ]] ||
    die "native Codex profile link must be owned by the current user: $CODEX_PROFILE_COMPAT_PATH"
  resolved_target=$(physical_symlink_target "$CODEX_PROFILE_COMPAT_PATH") ||
    die "native Codex profile link target does not exist: $CODEX_PROFILE_COMPAT_PATH"
  if [[ $resolved_target != "$CODEX_PROFILE_PATH" ]]; then
    if [[ ! -L $resolved_target ]]; then
      die "native Codex profile link points to a different file: $CODEX_PROFILE_COMPAT_PATH"
    fi
    resolved_target=$(physical_symlink_target "$resolved_target") ||
      die "native Codex profile link points to a different file: $CODEX_PROFILE_COMPAT_PATH"
  fi
  [[ $resolved_target == "$CODEX_PROFILE_PATH" ]] ||
    die "native Codex profile link points to a different file: $CODEX_PROFILE_COMPAT_PATH"
  direct_target=$(readlink "$CODEX_PROFILE_COMPAT_PATH")
  if [[ $direct_target != "$CODEX_PROFILE_PATH" ]]; then
    replace_symlink "$CODEX_PROFILE_COMPAT_PATH" "$CODEX_PROFILE_PATH" \
      "native Codex profile link"
  fi
}

resolve_claude_credential_source() {
  local host_claude_home

  [[ $CLAUDE_CONNECTION == official-subscription ]] || return 0
  if [[ $HOST_OS == Darwin ]]; then
    die "host Claude subscription credentials are stored in macOS Keychain; use --official-api or --profile"
  fi

  host_claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  CLAUDE_CREDENTIAL_PATH="$host_claude_home/.credentials.json"
  validate_owned_mode_600_file \
    "$CLAUDE_CREDENTIAL_PATH" "Claude OAuth credential"
  CLAUDE_CREDENTIAL_PATH=$(
    cd "$(dirname "$CLAUDE_CREDENTIAL_PATH")" &&
      printf '%s/%s\n' "$(pwd -P)" "$(basename "$CLAUDE_CREDENTIAL_PATH")"
  )
}

slug_for() {
  local raw=$1 fallback=$2 slug
  slug=$(LC_ALL=C printf '%s' "$raw" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-48)
  [[ -n $slug ]] || slug=$fallback
  printf '%s\n' "$slug"
}

path_hash_for() {
  printf '%s' "$1" | git hash-object --stdin | cut -c1-16
}

ensure_state_identity() {
  local state_dir=$1 connection_id=$2
  local identity="$state_dir/.docker-agent-identity"
  local expected
  expected=$(mktemp)
  printf '%s\0' \
    "$COMMON_DIR" "$CHECKOUT_ROOT" claude "$connection_id" >"$expected"

  if [[ -L $identity || (-e $identity && ! -f $identity) ]]; then
    rm -f "$expected"
    die "Claude state identity must be a regular non-symlink file: $identity"
  fi
  if [[ -e $identity ]]; then
    if [[ $(file_uid "$identity") != "$(id -u)" ||
          $(file_mode "$identity") != 600 ]]; then
      rm -f "$expected"
      die "Claude state identity has unsafe metadata: $identity"
    fi
    cmp -s "$expected" "$identity" || {
      rm -f "$expected"
      die "Claude state identity does not match: $state_dir"
    }
  else
    install -m 600 "$expected" "$identity"
  fi
  rm -f "$expected"
}

prepare_claude_state() {
  local repo_name repo_id worktree_id state_base

  if [[ $(basename "$COMMON_DIR") == .git ]]; then
    repo_name=$(basename "$(dirname "$COMMON_DIR")")
  else
    repo_name=$(basename "$COMMON_DIR")
  fi
  repo_id="$(slug_for "$repo_name" repo)-$(path_hash_for "$COMMON_DIR")"
  worktree_id="$(slug_for "$(basename "$CHECKOUT_ROOT")" worktree)-$(path_hash_for "$CHECKOUT_ROOT")"
  state_base="$DATA_HOME/claude/repos/$repo_id/worktrees/$worktree_id"

  case $CLAUDE_CONNECTION in
    official-subscription|official-api)
      CLAUDE_STATE_DIR="$state_base/$CLAUDE_CONNECTION"
      ;;
    profile:*)
      CLAUDE_STATE_DIR="$state_base/profiles/${CLAUDE_CONNECTION#profile:}"
      ;;
    *)
      die "unsupported Claude connection: $CLAUDE_CONNECTION"
      ;;
  esac

  install -d -m 700 "$CLAUDE_STATE_DIR"
  CLAUDE_STATE_DIR=$(cd "$CLAUDE_STATE_DIR" && pwd -P)
  ensure_state_identity "$CLAUDE_STATE_DIR" "$CLAUDE_CONNECTION"
}

# Optional per-agent hooks. An agent implements only the ones it needs:
# resolve_NAME_launch runs before any worktree is created, prepare_NAME_state
# runs once the final checkout and Git paths are known.
run_agent_hook() {
  local hook=$1
  if [[ $(type -t "$hook") == function ]]; then
    "$hook"
  fi
}

resolve_codex_launch() {
  local profile_dir legacy_profile
  [[ -n $CODEX_PROFILE_NAME ]] || return 0

  resolve_codex_home
  resolve_codex_profile_root
  profile_dir=$(cd "$CODEX_HOME_LOGICAL" && pwd -P)
  legacy_profile="$profile_dir/$CODEX_PROFILE_NAME.config.toml"
  CODEX_PROFILE_COMPAT_PATH="$CODEX_HOME_LOGICAL/$CODEX_PROFILE_NAME.config.toml"

  if resolve_managed_codex_profile; then
    ensure_codex_native_profile_link
    migrate_codex_profile_deprecated_features
    CODEX_PROFILE_MANAGED=1
  else
    CODEX_PROFILE_PATH=$legacy_profile
    validate_owned_mode_600_file "$CODEX_PROFILE_PATH" "Codex profile"
    CODEX_PROFILE_MANAGED=0
  fi
  path_is_within "$legacy_profile" "$CHECKOUT_ROOT" &&
    die "Codex profile must not be inside the checkout"
  return 0
}

resolve_claude_launch() {
  if [[ -z $CLAUDE_CONNECTION ]]; then
    if ! launcher_has_tty; then
      die "non-interactive Claude launch requires --official-subscription, --official-api, or --profile NAME"
    fi
    if ! menu_select "请选择 Claude Code 的连接方式：" \
      "Anthropic 官方订阅 / OAuth" \
      "Anthropic 官方 API key" \
      "自定义 endpoint"; then
      exit 130
    fi
    case $MENU_SELECTION in
      0)
        CLAUDE_CONNECTION=official-subscription

  DOCKER_ARGS+=(--network "$DEFAULT_NETWORK")
fi
for network in ${NETWORKS[@]+"${NETWORKS[@]}"}; do
  if ((DEFAULT_NETWORK_ENABLED)) && [[ $network == "$DEFAULT_NETWORK" ]]; then
    continue
  fi
  DOCKER_ARGS+=(--network "$network")
done
if launcher_has_tty; then
  DOCKER_ARGS+=(-it)
  # Docker only sets a bare TERM=xterm, which caps the container at 8 colors
  # and drops the background rendering agent TUIs use for their input box.
  # Forward the host capability instead; the entrypoint falls back when the
  # image has no terminfo entry for this terminal. Placed before --env specs
  # so an explicit --env TERM=... still wins.
  if [[ -n ${TERM:-} ]]; then
    DOCKER_ARGS+=(--env "TERM=$TERM")
  fi
  if [[ -n ${COLORTERM:-} ]]; then
    DOCKER_ARGS+=(--env "COLORTERM=$COLORTERM")
  fi
fi
DOCKER_ARGS+=(--env "HOST_UID=$(id -u)" --env "HOST_GID=$(id -g)")
if ((HOST_DOCKER)); then
  DOCKER_ARGS+=(--env "HOST_DOCKER_GID=$DOCKER_SOCKET_GID")
  DOCKER_ARGS+=(--env "DOCKER_HOST=unix:///var/run/docker.sock")
  DOCKER_ARGS+=(--mount "type=bind,source=$DOCKER_SOCKET,target=/var/run/docker.sock")
fi
for env_spec in ${ENV_SPECS[@]+"${ENV_SPECS[@]}"}; do
  DOCKER_ARGS+=(--env "$env_spec")
done
if [[ ${ENV_OVERRIDE_KEYS[0]+set} == set ]]; then
  env_override_key_list=
  for env_name in "${ENV_OVERRIDE_KEYS[@]}"; do
    if [[ -n $env_override_key_list ]]; then
      env_override_key_list+=,
    fi
    env_override_key_list+=$env_name
  done
  DOCKER_ARGS+=(--env "DOCKER_AGENT_ENV_OVERRIDE_KEYS=$env_override_key_list")
fi
append_same_path_mount "$CHECKOUT_ROOT"
"configure_${AGENT_SLUG}_runtime"
DOCKER_ARGS+=(--mount "type=volume,source=docker-codex-cache-$REPO_ID,target=/codex-cache")

if [[ -n $PAT_VALUE ]]; then
  install -d -m 700 "$DATA_HOME/pat"
  PAT_PATH=$DATA_HOME/pat/$REPO_ID
  (umask 077; printf '%s\n' "$PAT_VALUE" >"$PAT_PATH")
  chmod 600 "$PAT_PATH"
fi
if [[ -n $PAT_PATH ]]; then
  [[ -e $PAT_PATH ]] || die "PAT file does not exist: $PAT_PATH"
  [[ -f $PAT_PATH ]] || die "PAT path must be a regular file: $PAT_PATH"
  PAT_PATH=$(cd "$(dirname "$PAT_PATH")" && pwd -P)/$(basename "$PAT_PATH")
  reject_mount_comma "$PAT_PATH"
  DOCKER_ARGS+=(--mount "type=bind,source=$PAT_PATH,target=/codex-credentials/pat,readonly")
  # Git reads GIT_CONFIG_KEY_n/VALUE_n as extra config entries, so the
  # container gets a credential helper and an SSH-to-HTTPS rewrite for the
  # origin host without touching any config file shared with the host.
  # shellcheck disable=SC2016 # $(cat ...) must stay literal; git runs the helper.
  pat_helper='!f() { echo username=x-access-token; echo "password=$(cat /codex-credentials/pat)"; }; f'
  origin_url=
  if ((HAS_GIT)); then
    origin_url=$(git remote get-url origin 2>/dev/null || true)
  fi
  origin_host=$(parse_origin_host "$origin_url" 2>/dev/null || true)
  if [[ -n $origin_host ]]; then
    DOCKER_ARGS+=(--env "GIT_CONFIG_COUNT=3")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_0=credential.https://$origin_host.helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_0=$pat_helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_1=url.https://$origin_host/.insteadOf")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_1=git@$origin_host:")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_2=url.https://$origin_host/.insteadOf")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_2=ssh://git@$origin_host/")
  else
    DOCKER_ARGS+=(--env "GIT_CONFIG_COUNT=1")
    DOCKER_ARGS+=(--env "GIT_CONFIG_KEY_0=credential.helper")
    DOCKER_ARGS+=(--env "GIT_CONFIG_VALUE_0=$pat_helper")
  fi
fi

if ((HAS_GIT)); then
  if ! path_is_within "$COMMON_DIR" "$CHECKOUT_ROOT"; then
    append_same_path_mount "$COMMON_DIR"
  fi
  if ! path_is_within "$GIT_DIR" "$CHECKOUT_ROOT" &&
    ! path_is_within "$GIT_DIR" "$COMMON_DIR"; then
    append_same_path_mount "$GIT_DIR"
  fi
fi
for bind_spec in ${BIND_SPECS[@]+"${BIND_SPECS[@]}"}; do
  bind_mode=rw
  bind_path=$bind_spec
  if [[ $bind_spec == *:ro ]]; then
    bind_mode=ro
    bind_path=${bind_spec%:ro}
  fi
  [[ $bind_path == /* ]] ||
    die "--bind requires an absolute path: $bind_path"
  append_same_path_mount "$bind_path" "$bind_mode"
done

DOCKER_ARGS+=(--workdir "$START_DIR")
if [[ $HOST_OS == Linux ]]; then
  DOCKER_ARGS+=(--add-host "host.docker.internal:host-gateway")
elif [[ $HOST_OS != Darwin ]]; then
  die "unsupported host OS: $HOST_OS"
fi

# Clipboard image paste is forwarded by default; --disable-clipboard opts
# out. On WSLg only the Wayland socket is needed: the powershell.exe shim
# reads images through wl-paste, and Codex's first X11 attempt fails fast
# into that fallback. Native Linux reads the clipboard through the X11
# socket directly. Sockets are mounted as single read-only file binds.
# macOS uses the short-lived NSPasteboard bridge started after the image and
# network checks below, because Docker Desktop cannot mount the host clipboard.
if ((CLIPBOARD)); then
  if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
    DOCKER_ARGS+=(--env "WSL_DISTRO_NAME=$WSL_DISTRO_NAME")
    wayland_dir=${WAYLAND_DIR_OVERRIDE:-/mnt/wslg/runtime-dir}
  else
    wayland_dir=${WAYLAND_DIR_OVERRIDE:-${XDG_RUNTIME_DIR:-}}
  fi
  if [[ -n ${WAYLAND_DISPLAY:-} && -n $wayland_dir &&
        -e $wayland_dir/$WAYLAND_DISPLAY ]]; then
    reject_mount_comma "$wayland_dir"
    DOCKER_ARGS+=(--mount "type=bind,source=$wayland_dir/$WAYLAND_DISPLAY,target=/run/docker-codex/$WAYLAND_DISPLAY,readonly")
    DOCKER_ARGS+=(--env "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
    DOCKER_ARGS+=(--env "XDG_RUNTIME_DIR=/run/docker-codex")
  fi
  if [[ -z ${WSL_DISTRO_NAME:-} && -n ${DISPLAY:-} ]]; then
    x11_dir=${X11_DIR_OVERRIDE:-/tmp/.X11-unix}
    x11_num=${DISPLAY%%.*}
    x11_num=${x11_num#*:}
    x11_socket=$x11_dir/X$x11_num
    if [[ -e $x11_socket ]]; then
      reject_mount_comma "$x11_socket"
      DOCKER_ARGS+=(--mount "type=bind,source=$x11_socket,target=$x11_socket,readonly")
      DOCKER_ARGS+=(--env "DISPLAY=$DISPLAY")
      if [[ -n ${XAUTHORITY:-} && -f $XAUTHORITY ]]; then
        reject_mount_comma "$XAUTHORITY"
        DOCKER_ARGS+=(--mount "type=bind,source=$XAUTHORITY,target=$XAUTHORITY,readonly")
        DOCKER_ARGS+=(--env "XAUTHORITY=$XAUTHORITY")
      fi
    fi
  fi
fi

if ((HOST_DOCKER)); then
  warn_host_docker
fi

"$DOCKER_BIN" info >/dev/null 2>&1 ||
  die "Docker daemon is unavailable"

if ((DEFAULT_NETWORK_ENABLED)); then
  if ! "$DOCKER_BIN" network inspect "$DEFAULT_NETWORK" >/dev/null 2>&1; then
    if ! network_create_error=$(
      "$DOCKER_BIN" network create \
        --driver bridge \
        --label com.docker-agent.managed=true \
        "$DEFAULT_NETWORK" 2>&1
    ); then
      "$DOCKER_BIN" network inspect "$DEFAULT_NETWORK" >/dev/null 2>&1 ||
        die "failed to create default Docker network $DEFAULT_NETWORK: $network_create_error"
    fi
  fi
fi

prepare_selected_image
start_macos_clipboard_bridge

FINAL_ARGS=()
"${AGENT_SLUG}_final_args"

if [[ -n $MACOS_CLIPBOARD_DIR ]]; then
  final_status=0
  "$DOCKER_BIN" "${DOCKER_ARGS[@]}" "$IMAGE" "${FINAL_ARGS[@]}" || final_status=$?
  exit "$final_status"
fi
exec "$DOCKER_BIN" "${DOCKER_ARGS[@]}" "$IMAGE" "${FINAL_ARGS[@]}"
